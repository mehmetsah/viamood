# ============================================
# Via Mood Vendor Platform — Environment vars
# Copy to .env.local for development
# ============================================

# --- Database (Postgres) ---
# Production: Supabase / Neon / RDS
# Local dev: docker postgres veya brew install postgresql
DATABASE_URL=postgres://postgres:postgres@localhost:5432/viamood_vendor

# --- Redis (BullMQ + cache) ---
# Production: Upstash, Redis Cloud
# Local: docker redis
REDIS_URL=redis://localhost:6379

# --- Auth.js / NextAuth ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth providers (optional, fill what you use)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook — kimlik yoksa provider hic yuklenmez (giris ekraninda gorunmez).
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Apple — DIKKAT: Apple "client secret" VERMEZ.
# Asagidaki dort deger girilince secret'i biz uretiyoruz (ES256 JWT,
# lib/auth/apple-secret.ts) ve suresi dolmadan kendiliginden yeniliyoruz.
# Dorduden biri eksikse Apple girisi kapali kalir; digerleri etkilenmez.
#   AUTH_APPLE_ID          -> Service ID (ornek: com.viamood.giris) — App ID DEGIL
#   AUTH_APPLE_TEAM_ID     -> Apple Developer hesabinin Team ID'si (10 karakter)
#   AUTH_APPLE_KEY_ID      -> .p8 anahtarinin Key ID'si (10 karakter)
#   AUTH_APPLE_PRIVATE_KEY -> .p8 dosyasinin ICERIGI. Tek satira sigdirmak icin
#                             satir sonlari \n olarak kacisli yazilabilir.
AUTH_APPLE_ID=
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Email (Resend) ---
# SMTP (Resend yoksa yedek gönderim yolu) — Gmail: smtp.gmail.com / 587
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

RESEND_API_KEY=
EMAIL_FROM="Via Mood <noreply@viamood.com>"

# --- Shopify Admin API ---
SHOPIFY_STORE_DOMAIN=via-mood.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# --- Iyzico (marketplace + payment) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com

# --- KargoLab ---
KARGOLAB_API_URL=
KARGOLAB_API_KEY=

# --- Storage (Supabase or S3) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Sentry ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Application ---
NODE_ENV=development
APP_NAME="Via Mood Vendor Platform"
APP_URL=http://localhost:3000
