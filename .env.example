# ============================================
# Via Mood Vendor Platform — Environment vars
# Copy to .env.local for development
# ============================================

# --- Database (Postgres) ---
# Production: Supabase / Neon / RDS
# Local dev: docker postgres veya brew install postgresql
DATABASE_URL=postgres://postgres:postgres@localhost:5432/viamood_vendor

# --- Redis (BullMQ + cache) ---
# Production: Upstash, Redis Cloud
# Local: docker redis
REDIS_URL=redis://localhost:6379

# --- Auth.js / NextAuth ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth providers (optional, fill what you use)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Via Mood <noreply@viamood.com>"

# --- Shopify Admin API ---
SHOPIFY_STORE_DOMAIN=via-mood.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
SHOPIFY_WEBHOOK_SECRET=

# --- Iyzico (marketplace + payment) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Production: https://api.iyzipay.com

# --- KargoLab ---
KARGOLAB_API_URL=
KARGOLAB_API_KEY=

# --- Storage (Supabase or S3) ---
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Sentry ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Application ---
NODE_ENV=development
APP_NAME="Via Mood Vendor Platform"
APP_URL=http://localhost:3000
