{%- comment -%}  Via Mood — Ürün Sayfası Müşteri Yorumları (API-driven, moderasyonlu).  Onaylı yorumları hesap.viamood.com.tr'den ürün handle'ına göre çeker.  "Yorum yaz" formu POST → status=pending (admin onayına düşer). Additive section.{%- endcomment -%}<section class="vuy" id="vuy-{{ section.id }}"  data-vuy-api="https://hesap.viamood.com.tr/api/v1/storefront/reviews"  data-vuy-handle="{{ product.handle }}"  data-vuy-title="{{ product.title | escape }}">  <div class="vuy-wrap">    <div class="vuy-head">      <h2>{{ section.settings.baslik | default: "Ürün Yorumları" }}</h2>      <div class="vuy-trust" data-vuy-trust hidden>        <span class="vuy-avg" data-vuy-avg></span>        <span class="vuy-stars" aria-hidden="true">★★★★★</span>        <span class="vuy-count" data-vuy-count></span>      </div>      <button type="button" class="vuy-btn" data-vuy-open>Yorum yaz</button>    </div>    <div class="vuy-grid" data-vuy-grid></div>    <p class="vuy-empty" data-vuy-empty hidden>Bu ürün için henüz yorum yok. İlk yorumu sen bırak!</p>  </div>  <div class="vuy-modal" data-vuy-modal hidden>    <div class="vuy-modal-card" role="dialog" aria-modal="true" aria-label="Yorum yaz">      <button class="vuy-modal-close" type="button" data-vuy-close aria-label="Kapat">×</button>      <h3>Deneyimini paylaş</h3>      <p class="vuy-sub">Yorumun <strong>admin onayından</strong> sonra yayınlanır.</p>      <form data-vuy-form novalidate>        <div class="vuy-fstars" data-vuy-fstars role="radiogroup" aria-label="Puan">          <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>        </div>        <input type="hidden" name="puan" value="5">        <input name="isim" placeholder="Ad Soyad" required maxlength="80" autocomplete="name">        <textarea name="metin" placeholder="Bu ürünle ilgili deneyimini yaz..." required rows="4" maxlength="1000"></textarea>        <input type="text" name="website" class="vuy-hp" tabindex="-1" autocomplete="off" aria-hidden="true">        <button type="submit" class="vuy-btn vuy-btn-solid" data-vuy-submit>Yorumu gönder</button>        <p class="vuy-msg" data-vuy-msg role="status"></p>      </form>    </div>  </div></section><style>  #vuy-{{ section.id }}.vuy{--vuy-star:#f0a636;--vuy-ink:#22211f;--vuy-muted:#716d67;--vuy-line:#e7dfd5;--vuy-orange:#f06436;--vuy-paper:#fffdf9;padding:40px 0 12px;font-family:inherit;color:var(--vuy-ink)}  #vuy-{{ section.id }} .vuy-wrap{width:min(1100px,calc(100% - 32px));margin:auto}  #vuy-{{ section.id }} .vuy-head{display:flex;align-items:center;gap:16px;flex-wrap:wrap;border-top:1px solid var(--vuy-line);padding-top:24px;margin-bottom:16px}  #vuy-{{ section.id }} .vuy-head h2{font-family:"Playfair Display",Georgia,serif;font-size:26px;margin:0}  #vuy-{{ section.id }} .vuy-trust{display:inline-flex;align-items:center;gap:8px;font-size:14px}  #vuy-{{ section.id }} .vuy-avg{font-weight:800}  #vuy-{{ section.id }} .vuy-stars{color:var(--vuy-star);letter-spacing:1px}  #vuy-{{ section.id }} .vuy-count{color:var(--vuy-muted);font-size:13px}  #vuy-{{ section.id }} .vuy-btn{margin-left:auto;background:none;border:1.5px solid var(--vuy-line);border-radius:999px;padding:8px 16px;font-weight:700;font-size:14px;cursor:pointer;color:var(--vuy-ink);font-family:inherit}  #vuy-{{ section.id }} .vuy-btn-solid{background:var(--vuy-orange);color:#fff;border-color:var(--vuy-orange);margin:0;width:100%;padding:16px 28px!important}  #vuy-{{ section.id }} .vuy-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px}  #vuy-{{ section.id }} .vuy-card{background:var(--vuy-paper);border:1px solid var(--vuy-line);border-radius:16px;padding:16px 16px}  #vuy-{{ section.id }} .vuy-card .cs{color:var(--vuy-star);font-size:14px;letter-spacing:1px}  #vuy-{{ section.id }} .vuy-card .cs .off{color:#dcd3c6}  #vuy-{{ section.id }} .vuy-card p{margin:8px 0 12px;line-height:1.6;font-size:14px;color:#3c3934}  #vuy-{{ section.id }} .vuy-card .who{display:flex;align-items:center;gap:8px}  #vuy-{{ section.id }} .vuy-card .av{width:34px;height:34px;border-radius:50%;background:#efe0d0;color:var(--vuy-orange);display:grid;place-items:center;font-weight:800;font-size:14px}  #vuy-{{ section.id }} .vuy-card .who strong{font-size:13px}  #vuy-{{ section.id }} .vuy-card .vf{margin-left:auto;font-size:10px;font-weight:800;color:var(--vuy-orange)}  #vuy-{{ section.id }} .vuy-empty{color:var(--vuy-muted);font-size:14px;margin:16px 0 0}  #vuy-{{ section.id }} .vuy-modal{position:fixed;inset:0;z-index:9999;background:rgba(34,33,31,.55);display:flex;align-items:center;justify-content:center;padding:20px}  #vuy-{{ section.id }} .vuy-modal[hidden]{display:none!important}  #vuy-{{ section.id }} .vuy-modal-card{position:relative;background:var(--vuy-paper);border-radius:22px;padding:32px;width:min(500px,100%);max-height:90vh;overflow:auto;box-shadow:0 30px 80px rgba(0,0,0,.3)}  #vuy-{{ section.id }} .vuy-modal-close{position:absolute;top:12px;right:14px;background:none;border:none;font-size:26px;color:#999;cursor:pointer;line-height:1;padding:8px}  #vuy-{{ section.id }} .vuy-modal-card h3{font-family:"Playfair Display",serif;font-size:23px;margin:0 0 4px}  #vuy-{{ section.id }} .vuy-sub{color:var(--vuy-muted);font-size:13px;margin:0 0 16px}  #vuy-{{ section.id }} .vuy-modal-card form{display:flex;flex-direction:column;gap:12px}  #vuy-{{ section.id }} .vuy-modal-card input,#vuy-{{ section.id }} .vuy-modal-card textarea{width:100%;border:1px solid #ddd2c2;border-radius:11px;padding:12px 12px;font-family:inherit;font-size:14px;background:#fff}  #vuy-{{ section.id }} .vuy-fstars{display:flex;gap:4px;font-size:28px;color:#dcd3c6;cursor:pointer;user-select:none}  #vuy-{{ section.id }} .vuy-fstars span.on{color:var(--vuy-star)}  #vuy-{{ section.id }} .vuy-hp{position:absolute!important;left:-9999px!important;width:1px;height:1px}  #vuy-{{ section.id }} .vuy-msg{font-size:13px;margin:0;min-height:16px}  #vuy-{{ section.id }} .vuy-msg.ok{color:#3f7a3a}  #vuy-{{ section.id }} .vuy-msg.err{color:#c0392b}  .vuy-ozet{display:inline-flex;align-items:center;gap:8px;margin:8px 0 4px;text-decoration:none;color:inherit;font-size:14px}
  .vuy-ozet__st{color:#f0a636;letter-spacing:1px;font-size:14px}
  .vuy-ozet__st .off{color:#dcd3c6}
  .vuy-ozet{font-size:14px;line-height:1.35}
  /* MADDE 6 (Yunus, 17 Eyl): ortalama puan rakami DEV cikiyordu.
     Kok neden: bu blok H1'in hemen ALTINA enjekte ediliyor (asagida h1.insertAdjacent...),
     .vuy-ozet__avg'in font-size'i YOKTU -> baslik kapsayicisinin boyutunu MIRAS aliyordu.
     Olculdu (gercek tarayici, canli): 1280px'te 48px (H1 ile AYNI), 390px'te 36px
     (H1 19px -> rakam basligin ~2 KATI). Yildizlar 14px, sayi 13px oldugu icin
     satir "minik yildiz + dev rakam + minik yazi" gibi duruyordu.
     Cozum: hem kapsayiciya hem rakama ACIK font-size. Miras zinciri kesildi. */
  .vuy-ozet__avg{font-weight:800;font-size:15px}
  .vuy-ozet__n{color:#716d67;font-size:13px;text-decoration:underline;text-underline-offset:2px}
  .vuy-ozet:hover .vuy-ozet__n{color:#f06436}</style><script>  (function(){    var sec=document.getElementById('vuy-{{ section.id }}'); if(!sec) return;    var api=sec.getAttribute('data-vuy-api'), handle=sec.getAttribute('data-vuy-handle'), title=sec.getAttribute('data-vuy-title');    var grid=sec.querySelector('[data-vuy-grid]'), empty=sec.querySelector('[data-vuy-empty]');    function esc(s){var d=document.createElement('div');d.textContent=s==null?'':String(s);return d.innerHTML;}    function cs(n){n=Math.max(0,Math.min(5,n|0));var h='';for(var i=1;i<=5;i++){h+='<span'+(i<=n?'':' class="off"')+'>★</span>';}return h;}    function card(r){      var ini=(r.authorName||'V').trim().charAt(0).toUpperCase();      var vf=r.verifiedBuyer?'<span class="vf">✔ Doğrulanmış</span>':'';      return '<article class="vuy-card"><div class="cs">'+cs(r.rating)+'</div><p>'+esc(r.body)+'</p>'+        '<div class="who"><span class="av">'+esc(ini)+'</span><strong>'+esc(r.authorName||'Via Mood Müşterisi')+'</strong>'+vf+'</div></article>';    }
    /* ===== Ürün adı altı özet rozeti + Product JSON-LD (Yunus, 15 Ağu 2026 madde 1 ve 3) =====
       ⚠️ SADECE BU ÜRÜNE AİT onaylı yorum varsa çalışır. Site geneli ortalamayı her ürüne
       basmak uydurma rating olur -> Google yapısal veri MANUEL İŞLEM riski. API ?handle= ile
       ürün bazlı özet döndürüyor (count:0 / average:null) -> yorum yoksa hiçbir şey basılmaz. */
    function vuyOzetVeSchema(d){
      var n=Number(d.count)||0, avg=Number(d.average)||0;
      if(!(n>0&&avg>0)) return;
      try{
        var h1=document.querySelector('.product-information h1, .product-details h1, main h1');
        if(h1&&!document.querySelector('[data-vuy-ozet]')){
          var a=document.createElement('a');
          a.href='#vuy-{{ section.id }}'; a.setAttribute('data-vuy-ozet',''); a.className='vuy-ozet';
          a.innerHTML='<span class="vuy-ozet__st" aria-hidden="true">'+cs(Math.round(avg))+'</span>'+
                      '<span class="vuy-ozet__avg">'+String(avg).replace('.',',')+'</span>'+
                      '<span class="vuy-ozet__n">'+n+' değerlendirme</span>';
          a.addEventListener('click',function(e){e.preventDefault();sec.scrollIntoView({behavior:'smooth',block:'start'});});
          h1.insertAdjacentElement('afterend',a);
        }
      }catch(e){}
      try{
        var nodes=document.querySelectorAll('script[type="application/ld+json"]');
        for(var i=0;i<nodes.length;i++){
          var j; try{ j=JSON.parse(nodes[i].textContent); }catch(_){ continue; }
          var t=j&&j['@type'];
          if(t!=='Product'&&!(Object.prototype.toString.call(t)==='[object Array]'&&t.indexOf('Product')>-1)) continue;
          if(j.aggregateRating) break;
          j.aggregateRating={'@type':'AggregateRating',ratingValue:String(avg),reviewCount:String(n),bestRating:'5',worstRating:'1'};
          j.review=(d.reviews||[]).slice(0,5).map(function(r){
            return {'@type':'Review',
              reviewRating:{'@type':'Rating',ratingValue:String(r.rating||5),bestRating:'5',worstRating:'1'},
              author:{'@type':'Person',name:(r.authorName||'Via Mood Müşterisi')},
              reviewBody:(r.body||'')};
          });
          nodes[i].textContent=JSON.stringify(j);
          break;
        }
      }catch(e){}
    }    fetch(api+'?handle='+encodeURIComponent(handle),{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(d){      if(d&&d.ok&&d.reviews&&d.reviews.length){        grid.innerHTML=d.reviews.map(card).join('');        var t=sec.querySelector('[data-vuy-trust]');        if(d.average) sec.querySelector('[data-vuy-avg]').textContent=String(d.average).replace('.',',');        if(d.count) sec.querySelector('[data-vuy-count]').textContent='('+d.count+')';        if(t) t.hidden=false;        vuyOzetVeSchema(d);      } else { empty.hidden=false; }    }).catch(function(){ empty.hidden=false; });    var modal=sec.querySelector('[data-vuy-modal]');    function openModal(){modal.hidden=false;document.body.style.overflow='hidden';}    function closeModal(){modal.hidden=true;document.body.style.overflow='';}    sec.querySelector('[data-vuy-open]').addEventListener('click',openModal);    sec.querySelector('[data-vuy-close]').addEventListener('click',closeModal);    modal.addEventListener('click',function(e){if(e.target===modal)closeModal();});    document.addEventListener('keydown',function(e){if((e.key==='Escape'||e.key==='Esc')&&!modal.hidden)closeModal();});    var fs=sec.querySelector('[data-vuy-fstars]'), pi=sec.querySelector('input[name="puan"]');    function paint(n){[].forEach.call(fs.children,function(s,i){s.className=(i<n)?'on':'';});}    paint(5);    [].forEach.call(fs.children,function(s,i){s.addEventListener('click',function(){pi.value=i+1;paint(i+1);});});    var form=sec.querySelector('[data-vuy-form]'), msg=sec.querySelector('[data-vuy-msg]');    form.addEventListener('submit',function(e){      e.preventDefault();      var btn=sec.querySelector('[data-vuy-submit]');      var body={isim:form.isim.value.trim(),metin:form.metin.value.trim(),puan:Number(pi.value)||5,urun:title,urun_handle:handle,website:form.website.value};      msg.className='vuy-msg';msg.textContent='';      if(body.isim.length<2||body.metin.length<10){msg.className='vuy-msg err';msg.textContent='İsim ve en az 10 karakterlik yorum gerekli.';return;}      btn.disabled=true;btn.textContent='Gönderiliyor...';      fetch(api,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json();}).then(function(d){        if(d&&d.ok){msg.className='vuy-msg ok';msg.textContent=d.message||'Yorumun alındı, onaydan sonra yayınlanacak. Teşekkürler!';form.reset();pi.value=5;paint(5);setTimeout(closeModal,2200);}        else{msg.className='vuy-msg err';msg.textContent=(d&&d.error)||'Gönderilemedi, tekrar deneyin.';}      }).catch(function(){msg.className='vuy-msg err';msg.textContent='Bağlantı hatası, tekrar deneyin.';})      .then(function(){btn.disabled=false;btn.textContent='Yorumu gönder';});    });  })();</script>{% schema %}{  "name": "Ürün Yorumları",  "tag": "section",  "settings": [    { "type": "text", "id": "baslik", "label": "Başlık", "default": "Ürün Yorumları" }  ],  "presets": [{ "name": "Ürün Yorumları" }]}{% endschema %}