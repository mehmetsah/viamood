{%- doc -%}
  This snippet is used to render a product SKU.
  It is used in the sku block.

  @param {product} product_resource - The product to render
{%- enddoc -%}

{%- liquid
  assign sku = product_resource.selected_or_first_available_variant.sku
-%}

<div ref="skuContainer" class="sku-line">
  {%- if sku != blank -%}
    <span class="sku-label">Ürün Kodu:</span>
  {%- endif -%}
  <span
    class="sku"
    ref="sku"
    data-testid="product-sku"
  >
    {{- sku -}}
  </span>
</div>

<style>
  .sku-line{display:inline-flex;align-items:center;gap:6px}
  .sku-label{font-weight:600;opacity:.7}
  .sku{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-weight:500}
</style>
