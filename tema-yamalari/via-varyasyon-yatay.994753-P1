/*
 ViaMood — Yunus m9, yatay varyasyon kartlari (Shopify Horizon)
 YALNIZ ONIZLEME ICIN. Canli tema dosyasinda .vqb__group / .vqb__card
 DOM yapisi ve secim/stok/fiyat update calistigi dogrulandiktan sonra
 mevcut asset'e scoped eklenir. Liquid/JS/RADIO secim mantigi DEGISMEZ.
*/
@media (min-width: 375px) {
  .vqb__group {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 152px), 1fr));
    gap: 8px;
    align-items: stretch;
  }
  .vqb__group > .vqb__card {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    margin: 0;
  }
}
@media (max-width: 374px) {
  .vqb__group {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .vqb__group > .vqb__card {
    box-sizing: border-box;
    min-width: 0;
    width: 100%;
  }
}
