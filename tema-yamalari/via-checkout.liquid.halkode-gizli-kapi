  var _ilIlce=null;
  function loadIlIlce(){ if(_ilIlce) return Promise.resolve(_ilIlce); return fetch("{{ 'tr-il-ilce.json' | asset_url }}").then(function(r){return r.json();}).then(function(j){ _ilIlce=j; return j; }).catch(function(){return null;}); }
  function _norm(s){ return (s||'').trim().toLocaleLowerCase('tr'); }
  function deriveLoc(ilRaw, cityRaw){
    var out={ province:'', district:'' }; var j=_ilIlce;
