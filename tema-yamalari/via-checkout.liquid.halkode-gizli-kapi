    box.dataset.loadedFor = String(pid);
    var inCart={}; state.cart.items.forEach(function(it){ inCart[it.product_id]=1; });
    function pick(d){ return (d&&d.products)?d.products.filter(function(p){ return !inCart[p.id] && p.available!==false; }):[]; }
    fetch('/recommendations/products.json?product_id='+pid+'&limit=10&intent=complementary')
      .then(function(r){return r.json();}).then(function(d){
        var ps=pick(d); if(ps.length) return ps;
        return fetch('/recommendations/products.json?product_id='+pid+'&limit=10&intent=related').then(function(r){return r.json();}).then(pick);
      }).then(function(ps){
        if(!ps || !ps.length){ box.style.display='none'; return; }
        list.innerHTML = ps.slice(0,5).map(function(p){
          var img=p.featured_image||(p.images&&p.images[0])||''; if(img && img.indexOf('//')===0) img='https:'+img; if(img) img=img+(img.indexOf('?')>-1?'&':'?')+'width=200';
          var v=p.variants&&p.variants[0]; var vid=v?v.id:''; var price=toKurus(v?v.price:p.price);
          return '<div class="vco-xs" data-xs-vid="'+vid+'">'+
            '<a class="vco-xs__img" href="'+(p.url||'#')+'">'+(img?'<img src="'+img+'" alt="" loading="lazy">':'')+'</a>'+
            '<div class="vco-xs__t">'+(p.title||'')+'</div>'+
            '<div class="vco-xs__p">'+money(price)+'</div>'+
            '<button type="button" class="vco-xs__add" data-xs-add'+(vid?'':' disabled')+'>+ Ekle</button>'+
          '</div>';
        }).join('');
        box.style.display='block';
      }).catch(function(){ box.style.display='none'; });
  }

  /* ============ STEP 1 — Sepet render + düzenle ============ */
  function renderCart(){
    var c = state.cart; var box = $('[data-vco-cart]'); if(!box) return;
    if(!c || !c.items || !c.items.length){
      box.innerHTML = '<div class="vco-cart__loading">Sepetiniz boş. <a href="{{ routes.all_products_collection_url }}" style="color:#f25334;font-weight:700">Alışverişe başla →</a></div>';
      loadCrossSell(); return;
