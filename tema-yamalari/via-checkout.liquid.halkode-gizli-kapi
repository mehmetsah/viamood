    if(state.orderBusy) return; state.orderBusy = true;
    fetch('/cart/change.js', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ line:line, quantity:qty }) })
      .then(function(r){ return r.json().then(function(d){ return { ok:r.ok, d:d||{} }; }); })
      .then(function(res){
        state.orderBusy = false;
        document.querySelectorAll('.vco-li--busy').forEach(function(x){ x.classList.remove('vco-li--busy'); });
        if(!res.ok || !res.d.items){
          var mesaj = res.d.message || res.d.description || 'Bu adet için yeterli stok yok.';
          /* Önce tazele (renderCart innerHTML'i siler), SONRA uyarıyı bas — sıra ters
             olursa uyarı kendi render'ımızda siliniyor. */
          return vcoSepetTazele().then(function(){ vcoSepetUyari(mesaj); });
        }
        var cart = res.d;
        state.cart = cart;
        renderCart(); renderSummary(); updateCount(); updateCta();
        // ÜRÜN KALDIRMA / ADET DEĞİŞTİRME de kuponu geçersizleştirebilir: kupona hak
        // kazandıran ürün sepetten çıkınca indirim DÜŞMELİ. Bu çağrı eksikti — indirim
        // ekranda kalmaya devam ediyordu (Yunus, 11 Ağu).
        revalidatePromo();
      }).catch(function(){ state.orderBusy = false; document.querySelectorAll('.vco-li--busy').forEach(function(x){ x.classList.remove('vco-li--busy'); }); });
  }

  /* ============ Özet ============ */
  function renderSummary(){
    var c = state.cart; if(!c) return;
    var itemsEl = $('[data-vco-items]');
    if(itemsEl) itemsEl.innerHTML = c.items.map(function(it){
      return '<div class="vco-sum__it"><span>'+(it.product_title||it.title)+' <small>x'+it.quantity+'</small></span><span>'+money(it.final_line_price)+'</span></div>';
    }).join('');
    var sub = grossKurus(c); // indirimden ÖNCEki ara toplam — bkz. grossKurus()
    var ship = effShip(); // serbest kargo eşiği aşıldıysa 0
    var disc = Math.min(discountKurus(sub), sub); // indirim ara toplamı ASLA aşamaz
    var codFee = codFeeKurus(sub, ship); // kapıda kart komisyonu (kuruş)
    $('[data-vco-subtotal]').textContent = money(sub);
    var discRow = $('[data-vco-disc-row]');
    if(discRow){ discRow.style.display = disc>0 ? 'flex':'none'; var de=$('[data-vco-disc]'); if(de) de.textContent='−'+money(disc); var dl=$('[data-vco-disc-label]'); if(dl){ var dcode = state.discount ? state.discount.code : cartDiscountCode(c); var isCartDisc = !state.discount && c.total_discount > 0; dl.innerHTML = (dcode ? ('İndirim ('+dcode+')') : 'İndirim') + (isCartDisc ? ' <span data-vco-cartdisc-rm role="button" tabindex="0" style="color:#c0392b;cursor:pointer;font-weight:700;font-size:11px;text-decoration:underline;margin-left:5px">kaldır</span>' : ''); } }
    (function(){ var shipEl=$('[data-vco-ship-cost]'); if(!state.carrier){ shipEl.textContent='Seçilmedi'; } else if(ship===0){ var raw=state.shipping||0; shipEl.innerHTML=(raw>0?'<s style="color:#b3a89c;font-weight:400;margin-right:6px">'+moneyTl(raw)+'</s>':'')+'<b style="color:var(--ok)">Ücretsiz</b>'; } else { shipEl.textContent=moneyTl(ship); } })();
    var feeRow = $('[data-vco-codfee-row]');
    if(feeRow){ feeRow.style.display = codFee>0 ? 'flex':'none'; var fc=$('[data-vco-codfee]'); if(fc) fc.textContent = '+'+money(codFee); }
    $('[data-vco-total]').textContent = money(Math.max(0, sub - disc) + ship*100 + codFee);
    // ücretsiz kargo çubuğu
    var fb = $('[data-vco-free]');
    if(fb && FREE_ALL){ fb.style.display='block'; fb.style.textAlign='center'; fb.style.color='var(--ok)'; fb.innerHTML = IC.gift + ' Tüm siparişlerde ücretsiz kargo!'; }
    else if(fb && FREE_SHIP > 0){
      var subTl = (sub - disc)/100; // eşik indirim SONRASI nete bakar (bkz. effShip)
      if(subTl >= FREE_SHIP){ fb.style.display='block'; fb.style.textAlign='center'; fb.style.color='var(--ok)'; fb.innerHTML = IC.gift + ' Ücretsiz kargo kazandın!<span style="display:block;opacity:.7;font-weight:600;font-size:.9em;margin-top:1px">('+moneyTl(FREE_SHIP)+' ve üzeri)</span>'; }
      else { fb.style.display='block'; fb.style.textAlign='center'; fb.style.color='#c0392b'; fb.innerHTML = '🚚 Ücretsiz kargoya <b style="white-space:nowrap">'+moneyTl(FREE_SHIP-subTl)+'</b> kaldı<span style="display:block;opacity:.8;font-weight:600;font-size:.9em;margin-top:1px">('+moneyTl(FREE_SHIP)+' ve üzeri ücretsiz)</span>'; }
    }
  }
  function updateCount(){
    var n = state.cart ? state.cart.item_count : 0;
    var c = $('[data-vco-count]'); if(c) c.textContent = n ? '('+n+')' : '';
  }

  /* ============ Açık adres içerik kontrolü ============
     Müşteriler bu alana yalnızca il/ilçe yazıp geçiyordu; kargo firmaları sokak +
     bina no olmadan teslim edemeyip gönderiyi geri döndürüyordu (Yunus, 17 Ağu 2026). */
  var ADDR_HINT_VARSAYILAN = 'Sokak/cadde ve <b>bina no</b> zorunlu. İl ve ilçeyi tekrar yazmanıza gerek yok.';

  /* ===== Sokak / Bina / Daire ayrı kutular (Yunus 17 Ağu talebi — 27 Ağu 2026'da uygulandı)
     Tek "Açık Adres" kutusuna yalnız il yazanlar vardı; uyarı eklemek yetmedi, alan 3'e bölündü.
     Birleşik değer GİZLİ data-f="address1" alanında tutulur -> address1'i okuyan mevcut ~12 yer
     (kaydetme, payload, kayıtlı adres, localStorage) hiç değişmeden çalışmaya devam eder. */
  function addrParcaBirlestir(){
    var s=(f('addr_sokak')&&f('addr_sokak').value.trim())||'';
    var b=(f('addr_bina')&&f('addr_bina').value.trim())||'';
    var d=(f('addr_daire')&&f('addr_daire').value.trim())||'';
    var out=s;
    if(b) out += (out?' ':'')+'No:'+b;
    if(d) out += (out?' ':'')+'Daire:'+d;
    var h=f('address1'); if(h) h.value=out;
    return out;
  }
  function addrParcaAyikla(deger){
    var v=(deger||'').trim(); if(!v) return;
    var daire='', bina='', sokak=v;
    var md=v.match(/(?:daire|dai?re\s*no|d)\s*[:.]?\s*([0-9a-zA-Z\/-]+)\s*$/i);
    if(md){ daire=md[1]; sokak=v.slice(0,md.index).trim(); }
    var mb=sokak.match(/(?:bina\s*no|kapı\s*no|no)\s*[:.]?\s*([0-9a-zA-Z\/-]+)\s*$/i);
    if(mb){ bina=mb[1]; sokak=sokak.slice(0,mb.index).trim(); }
    sokak=sokak.replace(/[,\s]+$/,'');
    if(f('addr_sokak')) f('addr_sokak').value=sokak;
    if(f('addr_bina')) f('addr_bina').value=bina;
    if(f('addr_daire')) f('addr_daire').value=daire;
    addrParcaBirlestir();
  }

  function address1Sorun(){
    var sk=(f('addr_sokak')&&f('addr_sokak').value.trim())||'';
    var bn=(f('addr_bina')&&f('addr_bina').value.trim())||'';
    if(!sk) return 'Sokak / cadde adı zorunlu.';
    if(!bn) return 'Bina numarası zorunlu — örn. 42.';
    if(sk.replace(/\s+/g,'').length < 4) return 'Sokak / cadde adı çok kısa.';
    var v = sk;
    var sade = v.toLocaleLowerCase('tr').replace(/[.,\/]/g,' ').replace(/\s+/g,' ').trim();
    var il = (getIl()||'').toLocaleLowerCase('tr').trim();
    var ilce = (getIlce()||'').toLocaleLowerCase('tr').trim();
    var mah = (getMahalle()||'').toLocaleLowerCase('tr').trim();
    if(sade === il || sade === ilce || (mah && sade === mah)) return 'Buraya il/ilçe değil, sokak / cadde adı yazın.';
    return '';
  }
  function addrHintGuncelle(){
    var el = root.querySelector('[data-vco-addr-hint]'); if(!el) return;
    var inp = f('addr_sokak'); var deger = inp ? inp.value.trim() : '';
    var sorun = deger ? address1Sorun() : '';
    if(sorun){ el.textContent = sorun; el.classList.add('vco-addr-hint--hata'); }
    else { el.innerHTML = ADDR_HINT_VARSAYILAN; el.classList.remove('vco-addr-hint--hata'); }
  }

  /* ============ Adres geçerli mi ============ */
  function addrValid(){
    var need = ['first_name','last_name','phone','email','addr_sokak','addr_bina'];
    for(var i=0;i<need.length;i++){ if(!(f(need[i]) && f(need[i]).value.trim())) return false; }
    if(!f('email').value.includes('@')) return false;
    if(address1Sorun()) return false;
    var il = root.querySelector('#vco-province'); var ilce = root.querySelector('#vco-district');
    if(!(il && il.value) || !(ilce && ilce.value)) return false;
    return true;
  }
  function getIl(){ var il=root.querySelector('#vco-province'); return il?il.value:''; }
  function getIlce(){ var d=root.querySelector('#vco-district'); return d?d.value:''; }
  function getMahalle(){ var m=root.querySelector('#vco-neighborhood'); return m && m.value ? m.value : (root.querySelector('#vco-neighborhood-free')?root.querySelector('#vco-neighborhood-free').value:''); }
  function cartWeightKg(){ var g=0; (state.cart.items||[]).forEach(function(it){ g+=(it.grams||0)*it.quantity; }); return Math.max(0.5, g/1000); }

  /* ============ Kargo firmaları ============ */
  function loadCarriers(){
    var il = getIl(); if(!il) return;
    if(state.carriersLoadedFor === il) return;
    state.carriersLoadedFor = il;
    var box = $('[data-vco-carriers]'); var hint = $('[data-vco-ship-hint]');
    hint.textContent = 'Kargo firmaları yükleniyor…'; hint.style.display='block';
    fetch(API + '/api/v1/shipping/quote', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ province: il, weight: cartWeightKg() })
    }).then(function(r){ return r.json(); }).then(function(d){
      var rates = (d && d.all_rates && d.all_rates.length) ? d.all_rates
                : (d && d.courier ? [{courier:d.courier, price_tl:d.shipping_tl}] : []);
      if(!rates.length){ hint.textContent = 'Bu il için kargo bulunamadı, standart ücret uygulanacak.'; rates=[{courier:'Standart Kargo', price_tl:(d&&d.shipping_tl)||95}]; }
      hint.style.display='none';
      var _isFree = FREE_ALL || (FREE_SHIP > 0 && state.cart && (state.cart.items_subtotal_price/100) >= FREE_SHIP);
      box.innerHTML = rates.map(function(rt,i){
        return '<label class="vco-carrier" data-price="'+rt.price_tl+'" data-courier="'+rt.courier+'" data-cod="'+(rt.accepts_cod?1:0)+'" data-cod-card="'+(rt.accepts_cod_card?1:0)+'">'+
          '<span class="vco-carrier__l"><input type="radio" name="vco_carrier"'+(i===0?' checked':'')+'> '+IC.truck+' '+rt.courier+'</span>'+
          '<span class="vco-carrier__price">'+(_isFree?'<s style="color:#b3a89c;font-weight:400;margin-right:6px">'+moneyTl(rt.price_tl)+'</s><b style="color:var(--ok)">Ücretsiz</b>':moneyTl(rt.price_tl))+'</span></label>';
      }).join('');
      var first = box.querySelector('.vco-carrier');
      if(first) selectCarrier(first);
      box.querySelectorAll('.vco-carrier').forEach(function(el){
        el.addEventListener('click', function(){ el.querySelector('input').checked=true; selectCarrier(el); });
      });
    }).catch(function(){ hint.textContent='Kargo bilgisi alınamadı.'; });
  }
  function selectCarrier(el){
    root.querySelectorAll('.vco-carrier').forEach(function(x){ x.classList.remove('is-sel'); });
    el.classList.add('is-sel');
    state.carrier = el.dataset.courier;
    state.shipping = parseFloat(el.dataset.price) || 0;
    state.carrierCOD = el.dataset.cod === '1';
    state.carrierCODCard = el.dataset.codCard === '1';
    if(state.payMethod==='cod') renderCodOptions();
    renderSummary(); updateCta(); autoTrigger();
  }

  /* ============ Ödeme yöntemi seçimi ============ */
  function selectPm(method){
    state.payMethod = method;
    root.querySelectorAll('.vco-pm').forEach(function(el){ el.classList.toggle('is-sel', el.dataset.pm===method); });
    root.querySelectorAll('.vco-pm__body').forEach(function(el){ el.style.display = el.dataset.pmBody===method ? 'block':'none'; });
    var radio = root.querySelector('input[name="vco_pm"][value="'+method+'"]'); if(radio) radio.checked = true;
    if(method==='cod') renderCodOptions();
    renderSummary(); updateCta();
    if(method==='kart') autoTrigger();
  }

  /* ============ Kapıda Ödeme alt-seçenekleri (kargo firmasına göre — KargoLab acceptsCOD/acceptsCODCard) ============ */
  /* Ücretsiz kargo eşiği İNDİRİM SONRASI net tutara bakar. (11 Ağu 2026) Eskiden
     items_subtotal_price okunuyordu: Shopify kupon linkinde bu değer net, promosyon
     kutusuyla girilen kuponda ise brüt → aynı eşik iki kupon yolunda farklı davranıyor,
     ayrıca özetteki "ücretsiz kargo kazandın" çubuğu (brüt) ile çelişiyordu.
     FREE_ALL açıkken (bugünkü ayar) bu dal zaten hiç çalışmaz. */
  function netKurus(){ var g = grossKurus(); return Math.max(0, g - Math.min(discountKurus(g), g)); }
  function effShip(){ if(FREE_ALL) return 0; return (FREE_SHIP>0 && (netKurus()/100)>=FREE_SHIP) ? 0 : state.shipping; }
  function codFeeKurus(subKurus, shipTl){
    if(state.payMethod!=='cod' || state.codMethod!=='kart') return 0;
    if(subKurus==null){ if(!state.cart) return 0; subKurus = state.cart.items_subtotal_price; }
    if(shipTl==null) shipTl = effShip();
    return Math.round((subKurus - discountKurus(subKurus) + shipTl*100) * 0.04);
  }
  function codOpt(val,ic,title,desc){
    return '<label class="vco-cod-opt" data-cod-opt="'+val+'"><span class="vco-cod-opt__dot"></span>'+
      '<span class="vco-cod-opt__ic">'+ic+'</span>'+
      '<span class="vco-cod-opt__t"><b>'+title+'</b><small>'+desc+'</small></span>'+
      '<input type="radio" name="vco_cod" value="'+val+'" hidden></label>';
  }
  function markCodSel(box){ box.querySelectorAll('.vco-cod-opt').forEach(function(o){ o.classList.toggle('is-sel', o.dataset.codOpt===state.codMethod); }); }
  function renderCodOptions(){
    var box = $('[data-vco-cod-opts]'); if(!box) return;
    if(!state.carrier){ box.innerHTML='<p class="vco-hint">Önce kargo firması seçin — kapıda ödeme seçenekleri firmaya göre değişir.</p>'; state.codMethod=''; return; }
    if(state.codMethod==='nakit' && !state.carrierCOD) state.codMethod='';
    if(state.codMethod==='kart' && !state.carrierCODCard) state.codMethod='';
    var html='';
    if(state.carrierCOD) html += codOpt('nakit',IC.cash,'Nakit','Teslimatta kuryeye nakit öde');
    if(state.carrierCODCard) html += codOpt('kart',IC.card,'Kredi / Banka Kartı','Kuryenin POS cihazıyla öde · +%4 işlem komisyonu');
    if(!html){
      box.innerHTML='<p class="vco-hint" style="color:#c0392b"><b>'+state.carrier+'</b> kapıda ödeme kabul etmiyor. Lütfen başka bir kargo firması ya da ödeme yöntemi seç.</p>';
      state.codMethod=''; return;
    }
    if(!state.codMethod){ state.codMethod = state.carrierCOD ? 'nakit' : 'kart'; }
    box.innerHTML = '<p class="vco-hint" style="margin-bottom:8px"><b>'+state.carrier+'</b> ile kapıda nasıl ödeyeceksin?</p>' + html;
    box.querySelectorAll('input[name="vco_cod"]').forEach(function(r){ r.checked = (r.value===state.codMethod); });
    box.querySelectorAll('.vco-cod-opt').forEach(function(o){
      o.addEventListener('click', function(){ var inp=o.querySelector('input'); inp.checked=true; state.codMethod=inp.value; markCodSel(box); renderSummary(); updateCta(); });
    });
    markCodSel(box);
  }

  /* ============ İndirim kuponu ============ */
  /* İNDİRİM TABANI — ÇİFT SAYIM KORUMASI (11 Ağu 2026, Yunus bildirimi).
     Shopify kupon linki (/discount/KOD) indirimi SATIR BAZINDA uygular:
       original_total_price = 350  (indirimden önce)
       items_subtotal_price = 150  (ZATEN net)
       total_discount       = 200  (aynı indirim, ayrıca raporlanıyor)
     Özet "items_subtotal_price − total_discount" hesaplıyordu → 150 − 200 → Toplam 0,00 TL
     ve Ara Toplam ürün sayfasındaki 350 yerine 150 görünüyordu (ürün #132 / 18SETFIRSAT).
     Doğru taban indirimden ÖNCEki tutar; backend de ödemeyi ham line_item fiyatları
     üzerinden hesapladığı için (iyzico/paytr initialize) ikisi böylece aynı tabanı kullanır. */
  function grossKurus(c){
    c = c || state.cart; if(!c) return 0;
    return (c.total_discount > 0 && c.original_total_price) ? c.original_total_price : c.items_subtotal_price;
  }
  /* Sepetteki Shopify kuponunun KOD ADI. Kampanya linkiyle (/discount/KOD) gelen kuponlar
     SATIR bazında uygulanır → cart_level_discount_applications BOŞ olur; kod adı yalnızca
     line_level_discount_allocations içinde bulunur. Sadece cart-level'a bakmak kodu
     kaybediyordu (özet etiketi "İndirim" kalıyor, siparişe kupon adı yazılamıyordu). */
  function cartDiscountCode(c){
    c = c || state.cart; if(!c) return '';
    var cl = c.cart_level_discount_applications && c.cart_level_discount_applications[0];
    if(cl && cl.title) return cl.title;
    var code = '';
    (c.items||[]).forEach(function(it){
      (it.line_level_discount_allocations||[]).forEach(function(a){
        if(!code && a.discount_application && a.discount_application.title) code = a.discount_application.title;
      });
    });
    return code;
  }
  /* Kupon doğrulama isteğinde sepeti de yollarız — sunucu kapsamı (hangi ürünlere
     tanımlı) bilerek indirimi HESAPLAR. Fiyat cart.js `item.price` = indirim ÖNCESİ ham
     birim fiyat (kuruş); backend ödeme tutarını da aynı tabandan hesaplıyor. */
  function promoLineItems(){
    var c = state.cart; if(!c || !c.items) return [];
    return c.items.map(function(it){ return { variant_id: it.variant_id, quantity: it.quantity, price: it.price }; });
  }
  function discountKurus(subKurus){
    if(!state.discount){ if(state.cart && state.cart.total_discount > 0) return state.cart.total_discount; return 0; }
    if(subKurus==null){ if(!state.cart) return 0; subKurus = grossKurus(); }
    var d = state.discount;
    /* SUNUCU HESABI (tek doğruluk kaynağı): ürün-bazlı kuponlarda indirim yalnız HAK EDEN
       satırlara, o satırların tutarıyla sınırlı uygulanır. Tema kendi hesabını yapmaz —
       kapsamı bilmediği için yapamaz da (18SETFIRSAT açığının kökeni buydu). */
    if(d.amountKurus != null) return Math.min(d.amountKurus, subKurus);
    if(d.min_subtotal && (subKurus/100) < d.min_subtotal) return 0;
    var amt = d.type==='percentage' ? Math.round(subKurus * d.value/100) : Math.round(d.value*100);
    return Math.min(amt, subKurus);
  }
  function applyPromo(){
    var inp=$('[data-vco-promo-input]'), btn=$('[data-vco-promo-apply]'), msg=$('[data-vco-promo-msg]');
    var code=(inp.value||'').trim(); if(!code){ inp.focus(); return; }
    btn.disabled=true; btn.textContent='…'; msg.className='vco-promo__msg'; msg.textContent='Kontrol ediliyor…';
    fetch(API + '/api/v1/discount/validate', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ code:code, line_items: promoLineItems() }) })
      .then(function(r){ return r.json(); }).then(function(d){
        btn.disabled=false; btn.textContent='Uygula';
        if(!d.ok){ state.discount=null; msg.className='vco-promo__msg err'; msg.textContent='⛔ '+(d.error||'Kupon geçersiz.'); renderSummary(); updateCta(); return; }
        // Sunucu tutarı hesapladıysa (amount) onu kullan — min_subtotal/kapsam kontrolleri
        // orada zaten yapıldı. Eski sürümle uyum için amount yoksa yerel hesaba düşülür.
        var amtK = (typeof d.amount === 'number') ? Math.round(d.amount*100) : null;
        if(amtK === 0){ state.discount=null; msg.className='vco-promo__msg err'; msg.textContent='⛔ Bu kupon sepetindeki ürünlerde geçerli değil.'; renderSummary(); updateCta(); return; }
        state.discount = { code:d.code, type:d.type, value:d.value, min_subtotal:d.min_subtotal||0, amountKurus: amtK };
        showPromoApplied(); renderSummary(); updateCta(); autoTrigger();
      }).catch(function(){ btn.disabled=false; btn.textContent='Uygula'; msg.className='vco-promo__msg err'; msg.textContent='Bağlantı hatası.'; });
  }
  /* Kupon uygulandıktan SONRA sepet değişirse (ürün ekle/çıkar/adet) sunucunun hesapladığı
     tutar bayatlar — kapsam dışı ürün eklenip indirim olduğu gibi kalabilirdi. Sepet her
     yenilendiğinde kuponu sessizce yeniden doğrula; geçersizleşirse düşür ve kullanıcıya söyle.
     (Ödeme anında backend zaten yeniden hesaplıyor; bu, ekranın da doğru kalması için.) */
  function revalidatePromo(){
    if(!state.discount || !state.cart) return;
    var code = state.discount.code;
    fetch(API + '/api/v1/discount/validate', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ code:code, line_items: promoLineItems() }) })
      .then(function(r){ return r.json(); }).then(function(d){
        if(!state.discount || state.discount.code !== code) return; // arada değişmiş
        var amtK = (d.ok && typeof d.amount === 'number') ? Math.round(d.amount*100) : 0;
        if(!d.ok || amtK === 0){
          state.discount = null;
          var inp=$('[data-vco-promo-input]'), msg=$('[data-vco-promo-msg]');
          if(inp){ inp.disabled=false; inp.value=''; }
          if(msg){ msg.className='vco-promo__msg err'; msg.textContent='⛔ '+((d && d.error) || 'Kupon sepetindeki ürünlerde geçerli değil.'); }
        } else {
          state.discount.amountKurus = amtK;
        }
        renderSummary(); updateCta();
      }).catch(function(){ /* ağ hatası → mevcut tutar korunur, backend son sözü söyler */ });
  }
  function showPromoApplied(){
    var msg=$('[data-vco-promo-msg]'), inp=$('[data-vco-promo-input]');
    if(!state.discount){ msg.textContent=''; msg.className='vco-promo__msg'; return; }
    inp.value=state.discount.code; inp.disabled=true;
    msg.className='vco-promo__msg ok';
    msg.innerHTML='✓ “'+state.discount.code+'” uygulandı.<span class="vco-promo__rm" data-vco-promo-rm>kaldır</span>';
    var rm=msg.querySelector('[data-vco-promo-rm]'); if(rm) rm.addEventListener('click', removePromo);
  }
  /* Sunucu ÖDEME ANINDA kuponu reddettiyse: sessizce indirimsiz devam ETME.
     Kuponu düşür, tutarı güncelle ve müşteriye SEBEBİ göster.
     Kök neden (Yunus, 27 Ağu 2026 — OZEL10 "sepette yansıdı, PayTR'de yansımadı"):
     sepette müşterinin e-postası/telefonu henüz bilinmiyor, bu yüzden "tek müşteri bir kez"
     kontrolü orada çalışmıyor; kimlik ödeme adımında öğreniliyor ve kupon orada düşüyor. */
  function kuponReddedildi(d){
    if(!d || d.error !== 'discount_rejected') return false;
    state.discount = null;
    var i=$('[data-vco-promo-input]'); if(i){ i.disabled=false; i.value=''; }
    var m=$('[data-vco-promo-msg]');
    if(m){ m.className='vco-promo__msg err'; m.textContent='⛔ '+(d.message||'Kupon uygulanamadı.')+' Tutar güncellendi.'; }
    renderSummary(); updateCta();
    status('⛔ '+(d.message||'Kupon uygulanamadı.')+' Tutar güncellendi, tekrar deneyebilirsiniz.');
    return true;
  }

  function removePromo(){
    state.discount=null; var inp=$('[data-vco-promo-input]'); if(inp){ inp.disabled=false; inp.value=''; }
    var msg=$('[data-vco-promo-msg]'); if(msg){ msg.textContent=''; msg.className='vco-promo__msg'; }
    renderSummary(); updateCta(); autoTrigger();
  }

  /* ============ Step navigasyonu ============ */
  function goStep(n){
    state.step = n; root.setAttribute('data-step', n);
    status('');
    root.querySelectorAll('.vco-step').forEach(function(s){
      var sn = parseInt(s.dataset.go,10);
      s.classList.toggle('is-active', sn===n);
      s.classList.toggle('is-done', sn<n);
    });
    updateCta();
    var top = root.getBoundingClientRect().top + window.pageYOffset - 20;
    window.scrollTo({ top: top<0?0:top, behavior:'smooth' });
    if(n===2){ loadCarriers(); if(state.payMethod==='kart') autoTrigger(); }
  }

  /* ============ Sidebar CTA (step-aware) ============ */
  function updateCta(){
    var btn = $('[data-vco-cta]'); if(!btn) return;
    if(state.step===1){
      btn.disabled = !(state.cart && state.cart.items && state.cart.items.length);
      btn.textContent = 'Sepeti Onayla';
    } else if(state.step===2){
      if(state.orderBusy) return;
      var ok = addrValid() && state.carrier && state.payMethod;
      if(state.payMethod==='cod') ok = ok && !!state.codMethod; // kapıda: nakit/kart seçilmeli
      if(state.payMethod==='kart' && state.loadedSig && dataSig()===state.loadedSig){ btn.disabled=false; btn.textContent='✓ Ödeme formuna git'; return; }
      btn.disabled = !ok;
      var codCard = state.payMethod==='cod' && state.codMethod==='kart';
      btn.textContent = ok ? (state.payMethod==='kart' ? 'Kart ile Güvenli Öde' : (codCard ? 'Kapıda Kart ile Sipariş Ver' : 'Siparişi Tamamla')) : 'Adres, kargo ve ödeme seçin';
    } else { btn.disabled = true; btn.textContent = 'Tamamlandı'; }
  }

  function dataSig(){
    if(!addrValid() || !state.carrier) return '';
    var inv = (root.querySelector('input[name="vco_invoice"]:checked')||{}).value||'bireysel';
    return [f('first_name').value.trim(), f('last_name').value.trim(), f('phone').value.trim(), f('email').value.trim(),
      getIl(), getIlce(), getMahalle(), f('address1').value.trim(), f('postal_code').value.trim(),
      state.carrier, state.shipping, inv, (f('tc_no').value||'').trim(),
      (f('firma_adi').value||'').trim(), (f('vergi_no').value||'').trim(),
      root.querySelector('[data-vco-billing-diff]').checked ? '1':'0',
      state.discount?state.discount.code:'', discountKurus()].join('|');
  }

  function autoTrigger(){
    if(state.step!==2 || state.payMethod!=='kart') return;
    clearTimeout(state.autoTimer);
    state.autoTimer = setTimeout(function(){
      var sig = dataSig();
      if(!sig || state.initInFlight || sig === state.loadedSig) return;
      startKart({ auto:true });
    }, 800);
  }

  /* ============ Son adresi hatırla (localStorage — cihaz bazlı, MAHALLE dahil) ============ */
  var LS_ADDR='vm_last_addr', _saveAddrT;
