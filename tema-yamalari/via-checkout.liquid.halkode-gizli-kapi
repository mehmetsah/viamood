  var KART_GATEWAY = {{ section.settings.kart_gateway | default: 'iyzico' | json }}; // 'iyzico' | 'paytr' | 'halkode' (kart sağlayıcısı)
  /* Halköde GİZLİ KAPI (21 Eyl 2026). Yalnız ?halkode=1 ile gelen oturumda kart yolu
