  }
  function portalAdresleriYukle(){
    if(!saved) return;
    fetch('https://hesap.viamood.com.tr/api/v1/storefront/my-addresses', { credentials:'include' })
      .then(function(r){ return r.json(); })
      .then(function(j){
        if(j && j.ok && Array.isArray(j.adresler)) vakListeUygula(j.adresler);
        else hmacAdresleriYukle();
      })
      .catch(function(){ hmacAdresleriYukle(); });
  }
  portalAdresleriYukle();
  document.addEventListener('visibilitychange', function(){ if(document.visibilityState==='visible') portalAdresleriYukle(); });
  window.addEventListener('pageshow', function(e){ if(e && e.persisted) portalAdresleriYukle(); });
  function adresFormGoster(goster){
    var af=root.querySelector('[data-vco-adres-form]');
    if(af) af.style.display = goster ? '' : 'none';
  }
  /* TC Kimlik paylaşmak istemeyenler (Yunus, 17 Ağu 2026 talebi).
     Nihai tüketici e-arşiv faturasında TCKN yerine 11111111111 kullanılır. */
  var TC_NIHAI_TUKETICI = '11111111111';
  var tcYokKutu = root.querySelector('[data-vco-tc-yok]');
  if(tcYokKutu){
    tcYokKutu.addEventListener('change', function(){
      var el = f('tc_no'); if(!el) return;
      if(tcYokKutu.checked){
        el.dataset.oncekiTc = el.value || '';
        el.value = TC_NIHAI_TUKETICI;
        el.readOnly = true;
        el.style.background = '#f6f3ee';
      } else {
        el.value = el.dataset.oncekiTc || '';
        el.readOnly = false;
        el.style.background = '';
      }
    });
  }

  if(saved){ saved.addEventListener('change', function(){
    var o = saved.options[saved.selectedIndex];
    if(!o.value){
      // "— Yeni adres gir —" → form açılır + boşalt, il kaskadını sıfırla
      adresFormGoster(true);
      ['first_name','last_name','phone','address1','postal_code','addr_sokak','addr_bina','addr_daire'].forEach(function(k){ var el=f(k); if(el) el.value=''; });
      var ilEl=root.querySelector('#vco-province');
      if(ilEl){ ilEl.value=''; ilEl.dispatchEvent(new Event('change',{bubbles:true})); }
      state.savedAddress=false; updateCta();
      return;
    }
    adresFormGoster(false); // kayıtlı adres seçili → form gizli (değerler dolu taşınır)
    setTimeout(function(){ state.savedAddress = true; }, 0); // kayıtlı adres seçildi → tekrar KAYDETME
    f('first_name').value=o.dataset.first||''; f('last_name').value=o.dataset.last||'';
    f('phone').value=o.dataset.phone||''; f('address1').value=o.dataset.addr||''; f('postal_code').value=o.dataset.zip||'';
    addrParcaAyikla(o.dataset.addr||'');
    loadIlIlce().then(function(){
      var loc=deriveLoc(o.dataset.il, o.dataset.ilce); // il boşsa ilçeden türet
      var mah=o.dataset.mahalle||'';
      if(!mah){ try{ var last=JSON.parse(localStorage.getItem(LS_ADDR)||'null'); if(last && _norm(last.il)===_norm(loc.province) && _norm(last.ilce)===_norm(loc.district)) mah=last.mah||''; }catch(e){} } // saved adreste mahalle yoksa son kullanılandan (aynı il/ilçe) hatırla
      if(loc.province){ document.dispatchEvent(new CustomEvent('tr-cascade-preselect', { detail:{ idPrefix:'vco', province:loc.province, district:loc.district, neighborhood:mah } })); }
      // Cascade async — il set olana kadar poll, sonra kargo+cta+İyzico tetikle
      var _t=0; var _iv=setInterval(function(){
        _t++; var ilEl=root.querySelector('#vco-province');
        if((ilEl && ilEl.value) || _t>=24){ clearInterval(_iv); state.carriersLoadedFor=''; loadCarriers(); updateCta(); autoTrigger(); }
      }, 150);
    });
  }); }

  // Fatura tipi toggle
  root.querySelectorAll('input[name="vco_invoice"]').forEach(function(r){
    r.addEventListener('change', function(){
      var k = root.querySelector('input[name="vco_invoice"]:checked').value;
      root.querySelector('[data-vco-bireysel]').style.display = k==='bireysel'?'grid':'none';
      root.querySelector('[data-vco-kurumsal]').style.display = k==='kurumsal'?'grid':'none';
    });
  });
  // Sevk≠Fatura toggle
  root.querySelector('[data-vco-billing-diff]').addEventListener('change', function(e){
    root.querySelector('[data-vco-billing]').style.display = e.target.checked ? 'block':'none';
  });

  // Adres değişince: il seçilince kargo getir + cta + İyzico tazele
  root.addEventListener('change', function(e){
    if(e.target.id === 'vco-province' || e.target.closest('[data-role="province"]')){ state.carriersLoadedFor=''; loadCarriers(); }
    updateCta(); autoTrigger();
  });
  root.addEventListener('input', function(e){
    if(e.target && e.target.getAttribute && /^addr_(sokak|bina|daire)$/.test(e.target.getAttribute('data-f')||'')){ addrParcaBirlestir(); addrHintGuncelle(); }
    if(state.step===2){ updateCta(); autoTrigger(); }
  });

  // IBAN kopyala
  root.addEventListener('click', function(e){
    var b = e.target.closest('[data-copy]'); if(!b) return;
    var t = b.getAttribute('data-copy');
    if(navigator.clipboard) navigator.clipboard.writeText(t).then(function(){ b.textContent='Kopyalandı ✓'; setTimeout(function(){ b.textContent='IBAN Kopyala'; },1500); });
  });
})();
</script>

