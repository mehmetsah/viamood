{%- comment -%}
  Via Mood — 3 ADIMLI TEK SAYFA CHECKOUT
  1) Sepet Özeti (düzenlenebilir: adet +/-, kaldır)
  2) Teslimat ve Ödeme (adres + kargo + 3 ödeme yöntemi)
  3) Sipariş Sonucu
  Ödeme yöntemleri: Kredi/Banka Kartı (İyzico) · Havale/EFT (per-vendor IBAN) · Kapıda Ödeme (COD tahsilatlı kargo)
  page.odeme(-yeni).json template'ine eklenir.
{%- endcomment -%}

{%- comment -%} Premium ikon seti (Lucide — tek renk, currentColor; markup + JS tek kaynaktan) {%- endcomment -%}
{%- capture ic_card -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><path d="M2 10h20"/></svg>{%- endcapture -%}
{%- capture ic_bank -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 22h18"/><path d="M6 18v-7"/><path d="M10 18v-7"/><path d="M14 18v-7"/><path d="M18 18v-7"/><path d="m12 2 8 5H4Z"/></svg>{%- endcapture -%}
{%- capture ic_box -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>{%- endcapture -%}
{%- capture ic_cash -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>{%- endcapture -%}
{%- capture ic_truck -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>{%- endcapture -%}
{%- capture ic_gift -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5A4.8 8 0 0 1 12 8a4.8 8 0 0 1 4.5-5 2.5 2.5 0 0 1 0 5"/></svg>{%- endcapture -%}

<div class="vco" data-step="1">
  {%- comment -%} Stepper {%- endcomment -%}
  <div class="vco-steps">
    <button type="button" class="vco-step is-active" data-go="1"><span class="vco-step__n">1</span> Sepet Özeti <span class="vco-step__c" data-vco-count></span></button>
    <span class="vco-steps__sep"></span>
    <button type="button" class="vco-step" data-go="2"><span class="vco-step__n">2</span> Teslimat ve Ödeme</button>
    <span class="vco-steps__sep"></span>
    <div class="vco-step" data-go="3"><span class="vco-step__n">3</span> Sipariş Sonucu</div>
  </div>

  <div class="vco-grid">
    <div class="vco-main">

      {%- comment -%} ============ STEP 1 — SEPET ============ {%- endcomment -%}
      <div class="vco-panel vco-panel--1">
        <section class="vco-card">
          <h2 class="vco-card__title"><span class="vco-card__no">1</span> Sepet Özeti</h2>
          <div class="vco-cart" data-vco-cart>
            <div class="vco-cart__loading">Sepet yükleniyor…</div>
          </div>
        </section>
        <section class="vco-card vco-xsell" data-vco-xsell style="display:none">
          <h2 class="vco-card__title">Birlikte sık alınanlar</h2>
          <div class="vco-xsell__row" data-vco-xsell-list></div>
        </section>
      </div>

      {%- comment -%} ============ STEP 2 — TESLİMAT VE ÖDEME ============ {%- endcomment -%}
      <div class="vco-panel vco-panel--2">
        {%- comment -%} ----- Adres ----- {%- endcomment -%}
        <section class="vco-card" data-vco-address>
          <h2 class="vco-card__title"><span class="vco-card__no">2</span> Teslimat Adresi</h2>

          {%- if customer -%}
            {%- comment -%} Portal (hesap.viamood.com.tr) adresleri JS ile yüklenir (HMAC köprüsü);
                başarısız olursa aşağıdaki Shopify adresleri fallback kalır {%- endcomment -%}
            <div class="vco-saved" data-vco-saved-wrap{% if customer.addresses_count == 0 %} style="display:none"{% endif %}>
              <label class="vco-lbl">Kayıtlı adreslerim</label>
              <div class="vco-adres-kartlar" data-vco-kartlar style="display:none"></div>
              <select class="vco-input" data-vco-saved
                data-email="{{ customer.email | escape }}"
                data-sig="{{ customer.email | hmac_sha256: '15e66ee567ae0186394a79588f077a84ba483c8f341508f237bd5f7500524734' }}">
                <option value="">— Yeni adres gir —</option>
                {%- for ad in customer.addresses -%}
                  <option value="{{ forloop.index0 }}"
                    data-first="{{ ad.first_name | escape }}" data-last="{{ ad.last_name | escape }}"
                    data-phone="{{ ad.phone | escape }}" data-il="{{ ad.province | escape }}"
                    data-ilce="{{ ad.city | escape }}" data-mahalle="{{ ad.address2 | escape }}" data-addr="{{ ad.address1 | escape }}"
                    data-zip="{{ ad.zip | escape }}">
                    {{ ad.address1 | truncate: 40 }} — {{ ad.city }}/{{ ad.province }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}

          {%- comment -%} Adres form alanları — kayıtlı adres kartı seçiliyken GİZLİ
              (değerler dolu kalır, payload buradan okunmaya devam eder);
              "+ Yeni adres gir" seçilince görünür {%- endcomment -%}
          <div data-vco-adres-form>
          <div class="vco-row vco-row--2">
            <div><label class="vco-lbl">Ad *</label><input class="vco-input" data-f="first_name" autocomplete="given-name"></div>
            <div><label class="vco-lbl">Soyad *</label><input class="vco-input" data-f="last_name" autocomplete="family-name"></div>
          </div>
          <div class="vco-row vco-row--2">
            <div><label class="vco-lbl">Telefon *</label><input class="vco-input" data-f="phone" inputmode="tel" autocomplete="tel" placeholder="5xx xxx xx xx"></div>
            <div><label class="vco-lbl">E-posta *</label><input class="vco-input" data-f="email" type="email" autocomplete="email"{% if customer %} value="{{ customer.email | escape }}"{% endif %}></div>
          </div>

          {%- comment -%} İl / İlçe / Mahalle cascade (snippet — DOKUNMA) {%- endcomment -%}
          {% render 'tr-address-cascade',
              province_name: 'co_il', district_name: 'co_ilce', neighborhood_name: 'co_mahalle',
              id_prefix: 'vco', required: true %}

          <div class="vco-row vco-row--2" style="margin-top:10px">
            <div style="grid-column:1/-1">
              <label class="vco-lbl">Sokak / Cadde *</label>
              <input class="vco-input" data-f="addr_sokak" autocomplete="address-line1" placeholder="Örn: Atatürk Caddesi">
            </div>
            <div>
              <label class="vco-lbl">Bina No *</label>
              <input class="vco-input" data-f="addr_bina" placeholder="Örn: 42">
            </div>
            <div>
              <label class="vco-lbl">Daire No</label>
              <input class="vco-input" data-f="addr_daire" placeholder="Örn: 7">
            </div>
            <div style="grid-column:1/-1">
              <input type="hidden" data-f="address1">
              <p class="vco-hint vco-addr-hint" data-vco-addr-hint>Sokak/cadde ve <b>bina no</b> zorunlu. İl ve ilçeyi tekrar yazmanıza gerek yok.</p>
            </div>
          </div>
          <div class="vco-row vco-row--2">
            <div><label class="vco-lbl">Posta Kodu</label><input class="vco-input" data-f="postal_code" inputmode="numeric" autocomplete="postal-code"></div>
          </div>
          </div>{%- comment -%} /data-vco-adres-form {%- endcomment -%}

          {%- comment -%} Fatura tipi {%- endcomment -%}
          <div class="vco-inv">
            <label class="vco-lbl">Fatura Tipi</label>
            <div class="vco-seg">
              <label class="vco-seg__o"><input type="radio" name="vco_invoice" value="bireysel" checked> Bireysel</label>
              <label class="vco-seg__o"><input type="radio" name="vco_invoice" value="kurumsal"> Kurumsal</label>
            </div>
            <div class="vco-row vco-row--2" data-vco-bireysel style="margin-top:8px">
              <div style="grid-column:1/-1">
                <label class="vco-lbl">TC Kimlik No</label>
                <input class="vco-input" data-f="tc_no" inputmode="numeric" maxlength="11">
                <label class="vco-chk" style="margin-top:6px"><input type="checkbox" data-vco-tc-yok> TC Kimlik numaramı paylaşmak istemiyorum</label>
                <p class="vco-hint">İşaretlerseniz fatura nihai tüketici adına düzenlenir, alan <b>11111111111</b> olarak gönderilir.</p>
              </div>
            </div>
            <div class="vco-row vco-row--2" data-vco-kurumsal style="display:none;margin-top:8px">
              <div style="grid-column:1/-1"><label class="vco-lbl">Firma Adı</label><input class="vco-input" data-f="firma_adi"></div>
              <div><label class="vco-lbl">Vergi No</label><input class="vco-input" data-f="vergi_no" inputmode="numeric"></div>
              <div><label class="vco-lbl">Vergi Dairesi</label><input class="vco-input" data-f="vergi_dairesi"></div>
            </div>
          </div>

          {%- comment -%} Sevk ≠ Fatura {%- endcomment -%}
          <label class="vco-chk"><input type="checkbox" data-vco-billing-diff> Fatura adresim farklı</label>
          <div data-vco-billing style="display:none;margin-top:8px">
            <div class="vco-row vco-row--2">
              <div><label class="vco-lbl">Ad Soyad</label><input class="vco-input" data-f="billing_name" autocomplete="name"></div>
              <div><label class="vco-lbl">Telefon</label><input class="vco-input" data-f="billing_phone" inputmode="tel" autocomplete="tel"></div>
              <div style="grid-column:1/-1"><label class="vco-lbl">E-posta</label><input class="vco-input" data-f="billing_email" type="email" autocomplete="email"></div>
              <div style="grid-column:1/-1"><label class="vco-lbl">Fatura Açık Adres</label><input class="vco-input" data-f="billing_address1"></div>
            </div>
            {% render 'tr-address-cascade',
                province_name: 'co_bill_il', district_name: 'co_bill_ilce', neighborhood_name: 'co_bill_mahalle',
                id_prefix: 'vco-bill' %}
          </div>
        </section>

        {%- comment -%} ----- Kargo ----- {%- endcomment -%}
        <section class="vco-card" data-vco-shipping>
          <h2 class="vco-card__title">Kargo Firması</h2>
          <p class="vco-hint" data-vco-ship-hint>Önce il/ilçe seçin — uygun kargo firmaları listelenecek.</p>
          <div class="vco-carriers" data-vco-carriers></div>
        </section>

        {%- comment -%} ----- Ödeme Yöntemi ----- {%- endcomment -%}
        <section class="vco-card" data-vco-payment>
          <h2 class="vco-card__title">Ödeme Yöntemi</h2>

          {%- comment -%} Yöntem seçiciler — ÜSTTE YAN YANA, her zaman görünür {%- endcomment -%}
          <div class="vco-pm-row">
            <label class="vco-pm is-sel" data-pm="kart">
              <span class="vco-pm__dot"></span>
              <span class="vco-pm__ic">{{ ic_card }}</span>
              <span class="vco-pm__t"><b>Kredi / Banka Kartı</b><small>Tek çekim / taksit</small></span>
              <input type="radio" name="vco_pm" value="kart" checked hidden>
            </label>
            <label class="vco-pm" data-pm="havale">
              <span class="vco-pm__dot"></span>
              <span class="vco-pm__ic">{{ ic_bank }}</span>
              <span class="vco-pm__t"><b>Havale / EFT</b><small>1 iş günü onay</small></span>
              <input type="radio" name="vco_pm" value="havale" hidden>
            </label>
            {%- comment -%}
              Kapıda Ödeme (COD) — Mehmet talimatıyla KAPATILDI (10 Ağu 2026).
              Yeniden açmak için: Theme Editor > bu bölüm > "Kapıda Ödeme açık" kutusunu işaretle.
              Sunucu tarafında da ayrı bir kapı var (COD_ENABLED env, /api/v1/payment/cod/create)
              — ikisi birlikte açılmalı.
            {%- endcomment -%}
            {%- if section.settings.cod_enabled -%}
              <label class="vco-pm" data-pm="cod">
                <span class="vco-pm__dot"></span>
                <span class="vco-pm__ic">{{ ic_box }}</span>
                <span class="vco-pm__t"><b>Kapıda Ödeme</b><small>Teslimde nakit/kart</small></span>
                <input type="radio" name="vco_pm" value="cod" hidden>
              </label>
            {%- endif -%}
          </div>

          {%- comment -%} Seçilen yöntemin içeriği — ALTTA tek alanda açılır {%- endcomment -%}
          <div class="vco-pm__body" data-pm-body="kart">
            <div id="iyzico-container" class="vco-iyzico" data-vco-iyzico style="display:none">
              <div class="vco-loading" data-vco-loading><div class="vco-spin"></div><p>Güvenli ödeme formu hazırlanıyor…</p></div>
              <div class="vco-err" data-vco-err style="display:none"></div>
            </div>
            <p class="vco-hint" data-vco-kart-gate>Adres ve kargo seçimini tamamlayın — kart formu otomatik açılacak.</p>
          </div>
          <div class="vco-pm__body" data-pm-body="havale" style="display:none">
            <p class="vco-hint">“Siparişi Tamamla”ya bastığında sana bir <b>sipariş kodu</b> ve <b>banka bilgilerimizi</b> vereceğiz. Havale/EFT açıklamasına sipariş kodunu mutlaka yaz. Ödemeni en geç 3 iş günü içinde yapmazsan sipariş otomatik iptal olur.</p>
          </div>
          {%- if section.settings.cod_enabled -%}
            <div class="vco-pm__body" data-pm-body="cod" style="display:none">
              <div class="vco-cod" data-vco-cod-opts></div>
            </div>
          {%- endif -%}
        </section>
      </div>

      {%- comment -%} ============ STEP 3 — SONUÇ ============ {%- endcomment -%}
      <div class="vco-panel vco-panel--3">
        <section class="vco-card vco-result" data-vco-result></section>
      </div>

    </div>

    {%- comment -%} ============ ÖZET (sticky) ============ {%- endcomment -%}
    <aside class="vco-sum">
      <div class="vco-free" data-vco-free style="display:none"></div>
      <h2 class="vco-sum__title">Sipariş Özeti</h2>
      <div class="vco-sum__items" data-vco-items></div>
      <div class="vco-promo" data-vco-promo>
        <input type="text" class="vco-promo__inp" data-vco-promo-input placeholder="İndirim kodu" autocomplete="off" spellcheck="false">
        <button type="button" class="vco-promo__btn" data-vco-promo-apply>Uygula</button>
      </div>
      <div class="vco-promo__msg" data-vco-promo-msg></div>
      <div class="vco-sum__row"><span>Ara Toplam</span><span data-vco-subtotal>—</span></div>
      <div class="vco-sum__row vco-sum__row--disc" data-vco-disc-row style="display:none"><span data-vco-disc-label>İndirim</span><span data-vco-disc>—</span></div>
      <div class="vco-sum__row"><span>Kargo</span><span data-vco-ship-cost>Seçilmedi</span></div>
      <div class="vco-sum__row" data-vco-codfee-row style="display:none"><span>Kapıda kart komisyonu (%4)</span><span data-vco-codfee>—</span></div>
      <div class="vco-sum__row vco-sum__row--total"><span>Toplam</span><span data-vco-total>—</span></div>
      <button type="button" class="vco-cta" data-vco-cta>Sepeti Onayla</button>
      <p class="vco-sum__status" data-vco-status></p>
      <a href="{{ routes.all_products_collection_url }}" class="vco-back">← Alışverişe Devam Et</a>
    </aside>
  </div>
</div>

<style>
  .vco { max-width: 1180px; margin: 24px auto 60px; padding: 0 16px; --o:#f25334; --ink:#1a1a1a; --line:#e7e3dc; --muted:#7a7268; --ok:#1f7a4d; --ic:#f25334; }
  .vco svg { display:block; }
  .vco * { box-sizing: border-box; }
  /* Tema body'sinde overflow-x:hidden → overflow-y'yi auto'ya zorlayıp özet sticky'sini kırıyordu. clip yatayı keser ama scroll-container YARATMAZ → sticky korunur. */
  body { overflow-x: clip !important; overflow-y: visible !important; }
  /* Stepper */
  .vco-steps { display:flex; align-items:center; gap:6px; justify-content:center; margin:8px 0 28px; flex-wrap:wrap; }
  .vco-step { display:flex; align-items:center; gap:8px; font-size:14px; font-weight:600; color:#b3a89c; background:none; border:0; cursor:default; padding:4px 6px; font-family:inherit; }
  .vco-step[data-go="1"], .vco-step[data-go="2"] { cursor:pointer; }
  .vco-step__n { width:26px;height:26px;border-radius:50%;background:#ece7df;color:#b3a89c;display:grid;place-items:center;font-size:13px;flex:0 0 auto; }
  .vco-step__c { font-size:12px;color:var(--muted);font-weight:700; }
  .vco-steps__sep { width:34px;height:2px;background:#ece7df;border-radius:2px; }
  .vco-step.is-active { color:var(--ink); } .vco-step.is-active .vco-step__n { background:var(--o); color:#fff; }
  .vco-step.is-done { color:var(--ink); } .vco-step.is-done .vco-step__n { background:var(--ok); color:#fff; }
  /* Layout */
  .vco-grid { display:grid; grid-template-columns: 1fr 360px; gap:24px; align-items:start; }
  .vco-card { background:#fff; border:1px solid var(--line); border-radius:14px; padding:20px; margin-bottom:18px; }
  .vco-card__title { font-size:1.05rem; font-weight:800; color:var(--ink); margin:0 0 16px; display:flex; align-items:center; gap:10px; }
  .vco-card__no { width:26px;height:26px;border-radius:50%;background:var(--o);color:#fff;display:grid;place-items:center;font-size:14px;flex:0 0 auto; }
  /* Panel switching */
  .vco[data-step="1"] .vco-panel--2, .vco[data-step="1"] .vco-panel--3,
  .vco[data-step="2"] .vco-panel--1, .vco[data-step="2"] .vco-panel--3,
  .vco[data-step="3"] .vco-panel--1, .vco[data-step="3"] .vco-panel--2 { display:none; }
  /* ----- STEP 1: Sepet (ferah, sıkışmasız) ----- */
  .vco-cart__loading { padding:30px; text-align:center; color:var(--muted); }
  .vco-li { display:flex; align-items:center; gap:16px; padding:18px 0; border-bottom:1px solid #efe9e0; }
  .vco-li:last-child { border-bottom:0; }
  .vco-li__img { width:72px; height:72px; border-radius:10px; background:#f6f3ee; flex:0 0 auto; overflow:hidden; display:grid; place-items:center; }
  .vco-li__img img { width:100%; height:100%; object-fit:cover; }
  .vco-li__info { flex:1 1 auto; min-width:0; }
  .vco-li__title { font-size:15px; font-weight:700; color:var(--ink); line-height:1.3; overflow-wrap:anywhere; word-break:break-word; }
  .vco-li__opt { font-size:12.5px; color:var(--muted); margin-top:3px; }
  .vco-qty { display:inline-flex; align-items:center; border:1px solid var(--line); border-radius:999px; flex:0 0 auto; background:#fff; }
  .vco-qty button { width:40px; height:40px; border:0; background:none; font-size:20px; color:var(--ink); cursor:pointer; display:grid; place-items:center; border-radius:999px; }
  .vco-qty button:hover { background:#f6f3ee; }
  .vco-qty span { min-width:42px; text-align:center; font-size:15px; font-weight:700; }
  .vco-li--busy .vco-qty { pointer-events:none; opacity:.5; position:relative; }
  .vco-li--busy .vco-qty::after { content:''; position:absolute; top:50%; left:50%; width:18px; height:18px; margin:-9px 0 0 -9px; border:2px solid var(--o); border-top-color:transparent; border-radius:50%; animation:vco-spin .6s linear infinite; }
  @keyframes vco-spin { to { transform:rotate(360deg); } }
  .vco-li__rm { width:40px; height:40px; flex:0 0 auto; border:1px solid var(--line); background:#fff; border-radius:10px; cursor:pointer; display:grid; place-items:center; color:#c0392b; margin-left:4px; }
  .vco-li__rm:hover { background:#fdecea; border-color:#f5b7b1; }
  .vco-li__rm svg { width:19px; height:19px; }
  .vco-li__price { font-size:15px; font-weight:800; color:var(--ink); min-width:84px; text-align:right; flex:0 0 auto; }
  /* ----- STEP 2: Form ----- */
  .vco-lbl { display:block; font-size:12px; font-weight:600; color:var(--muted); margin:0 0 4px; }
  .vco-input, .vco select { width:100%; padding:11px 12px; border:1px solid var(--line); border-radius:8px; font-size:14px; background:#fff; color:var(--ink); }
  .vco-input:focus, .vco select:focus { outline:none; border-color:var(--o); }
  .vco-input::placeholder, .vco-promo__inp::placeholder, .vco select::placeholder { color:#b3a89c; opacity:1; }
  .vco-row { display:grid; gap:10px; margin-bottom:10px; }
  .vco-row--2 { grid-template-columns: 1fr 1fr; }
  .vco-saved { margin-bottom:14px; }
