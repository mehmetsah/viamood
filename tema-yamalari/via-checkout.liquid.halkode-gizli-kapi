  /* ============ Ortak sipariş payload ============ */
  function buildPayload(cart){
    var inv = (root.querySelector('input[name="vco_invoice"]:checked')||{}).value || 'bireysel';
    return {
      line_items: cart.items.map(function(it){ return { variant_id:it.variant_id, quantity:it.quantity, title:it.product_title||it.title, price:it.price, product_type:it.product_type||'Genel', sku:it.sku||'' }; }),
      shipping_cost: effShip(),
      shipping_courier: state.carrier||'',
      saved_address: state.savedAddress ? '1' : '',
      payment_method: state.payMethod,
      cod_method: state.payMethod==='cod' ? (state.codMethod||'nakit') : '',
      cod_surcharge: (function(){ var fk=codFeeKurus(grossKurus(cart), effShip()); return fk>0 ? +(fk/100).toFixed(2) : 0; })(),
      discount_code: state.discount ? state.discount.code : cartDiscountCode(cart),
      discount_amount: (function(){ var g=grossKurus(cart); var dk=Math.min(discountKurus(g), g); return dk>0 ? +(dk/100).toFixed(2) : 0; })(),
      first_name:f('first_name').value.trim(), last_name:f('last_name').value.trim(),
      phone:f('phone').value.trim(), email:f('email').value.trim(),
      {%- if customer -%}customer_id: {{ customer.id | json }}, customer_email: {{ customer.email | json }},{%- endif -%}
      address1:f('address1').value.trim(), address2:getMahalle(),
      city:getIlce(), province:getIl(), zip:f('postal_code').value.trim(),
      identity_number:(f('tc_no').value||'11111111111').trim()||'11111111111',
      invoice_type:inv, tc_no:(f('tc_no').value||'').trim(),
      firma_adi:(f('firma_adi').value||'').trim(), vergi_no:(f('vergi_no').value||'').trim(), vergi_dairesi:(f('vergi_dairesi').value||'').trim(),
      billing_diff: root.querySelector('[data-vco-billing-diff]').checked ? '1':'0',
      billing_address1:(f('billing_address1').value||'').trim(),
      billing_name:(f('billing_name').value||'').trim(), billing_phone:(f('billing_phone').value||'').trim(), billing_email:(f('billing_email').value||'').trim(),
      billing_il:(root.querySelector('#vco-bill-province')||{}).value||'', billing_ilce:(root.querySelector('#vco-bill-district')||{}).value||''
    };
  }

  /* ============ İyzico (Kredi Kartı) ============ */
  function clearIyzico(){
    var old = document.getElementById('iyzipay-checkout-form'); if(old) old.remove();
    document.querySelectorAll('script[data-vco-iyzi], script[src*="iyzipay.com"]').forEach(function(s){ s.remove(); });
    try { window.iyziInit = undefined; } catch(e){}
    try { window.iyziWebpackJsonp = undefined; } catch(e){}
  }
  function injectIyzico(html){
    var c = $('#iyzico-container');
    $('[data-vco-loading]').style.display='none';
    var temp = document.createElement('div'); temp.innerHTML = html;
    if(!document.getElementById('iyzipay-checkout-form')){
      var d=document.createElement('div'); d.id='iyzipay-checkout-form'; d.className='responsive'; c.appendChild(d);
    }
    temp.querySelectorAll('script').forEach(function(old){
      var s=document.createElement('script'); if(old.src) s.src=old.src; else s.textContent=old.textContent; if(old.type) s.type=old.type;
      s.setAttribute('data-vco-iyzi','1'); document.body.appendChild(s);
    });
  }
  function scrollToPay(){ var p=$('[data-vco-payment]'); if(p) p.scrollIntoView({behavior:'smooth', block:'start'}); }
  /* ============ PayTR (Kredi Kartı — gateway toggle; İyzico'ya paralel) ============ */
  function startKart(opts){ if(KART_GATEWAY==='halkode') startPaymentHalkode(opts); else if(KART_GATEWAY==='paytr') startPaymentPaytr(opts); else startPayment(opts); }
  function clearPaytr(){ var i=document.getElementById('paytriframe'); if(i) i.remove(); }
  function injectPaytr(url){
    $('[data-vco-loading]').style.display='none';
    var c=$('#iyzico-container');
    var ifr=document.createElement('iframe'); ifr.id='paytriframe'; ifr.src=url;
    ifr.setAttribute('frameborder','0'); ifr.setAttribute('scrolling','no'); ifr.style.width='100%'; ifr.style.minHeight='620px'; ifr.style.border='0';
    c.appendChild(ifr);
    if(!document.getElementById('paytr-resizer')){
      var s=document.createElement('script'); s.id='paytr-resizer'; s.src='https://www.paytr.com/js/iframeResizer.min.js';
      s.onload=function(){ try{ window.iFrameResize({}, '#paytriframe'); }catch(e){} };
      document.body.appendChild(s);
    } else { try{ window.iFrameResize({}, '#paytriframe'); }catch(e){} }
  }
  function startPaymentPaytr(opts){
    opts = opts || {};
    if(!addrValid()){ if(!opts.auto) status(address1Sorun() || 'Lütfen adres bilgilerini eksiksiz doldurun.'); return; }
    if(!state.carrier){ if(!opts.auto) status('Lütfen kargo firması seçin.'); return; }
    var sig = dataSig();
    if(state.initInFlight) return;
    if(sig && sig === state.loadedSig){ if(!opts.auto) scrollToPay(); return; }
    state.initInFlight = true;
    var btn=$('[data-vco-cta]'); btn.disabled=true; btn.textContent = state.loadedSig ? 'Tutar güncelleniyor…' : 'Ödeme yükleniyor…';
    status('');
    var gate = $('[data-vco-kart-gate]'); if(gate) gate.style.display='none';
    $('[data-vco-iyzico]').style.display='block';
    clearIyzico(); clearPaytr();
    $('[data-vco-loading]').style.display='block';
    $('[data-vco-err]').style.display='none';
    if(!opts.auto) scrollToPay();
    saveAttrs().then(function(){ return fetch('/cart.js').then(function(r){return r.json();}); }).then(function(cart){
      return fetch(API + '/api/v1/payment/paytr/initialize', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(buildPayload(cart)) });
    }).then(function(r){ return r.json(); }).then(function(data){
      state.initInFlight = false;
      if(!data.ok || !(data.iframe_url || data.token)){
        $('[data-vco-loading]').style.display='none';
        if(kuponReddedildi(data)){ btn.disabled=false; btn.textContent='Ödemeyi tekrar dene'; return; }
        $('[data-vco-err]').style.display='block';
        $('[data-vco-err]').textContent = '⛔ ' + (data.message || data.detail || data.error || 'PayTR ödeme formu başlatılamadı.');
        btn.disabled=false; btn.textContent='Ödemeyi tekrar dene';
        return;
      }
      injectPaytr(data.iframe_url || ('https://www.paytr.com/odeme/guvenli/' + data.token));
      state.loadedSig = sig;
      btn.disabled=false; btn.textContent='✓ Ödeme formuna git';
    }).catch(function(err){
      state.initInFlight=false; $('[data-vco-loading]').style.display='none';
      $('[data-vco-err]').style.display='block'; $('[data-vco-err]').textContent='⛔ Bağlantı hatası: '+(err.message||err);
      btn.disabled=false; btn.textContent='Ödemeyi tekrar dene';
    });
  }

  /* ============ Halköde (Kredi Kartı — kart formu + taksit + 3D Secure) ============
     PayTR iframe'inden FARKI: kart bilgisi bizim API'miz üzerinden Halköde'ye iletilir.
     Bu kodda kart alanları HİÇBİR yere yazılmaz (console, localStorage, sepet özniteliği
     YOK; dataSig/saveAttrs data-f okur, bu alanlar data-hk). Kart yalnız "Ödeme Yap"
     anında initialize gövdesine konur. Taslak sipariş form doldurulurken DEĞİL, o anda
     açılır. Oturum kaydı (Clarity) için alanlar data-clarity-mask ile maskelenir. */
  var hk = { amountKurus:0, bin:'', seq:0, busy:false };
  function hkEl(n){ return root.querySelector('[data-hk="'+n+'"]'); }
  function hkDigits(v){ return String(v==null?'':v).replace(/\D/g,''); }
  function hkTotalKurus(){ var g=grossKurus(); return Math.max(0, g - Math.min(discountKurus(g), g)) + Math.round(effShip()*100); }
  function hkLuhn(n){ var s=0, alt=false; for(var i=n.length-1;i>=0;i--){ var d=n.charCodeAt(i)-48; if(alt){ d*=2; if(d>9) d-=9; } s+=d; alt=!alt; } return s%10===0; }
  function hkErr(msg){ var e=$('[data-vco-err]'); if(!e) return; if(msg){ e.textContent=msg; e.style.display='block'; } else { e.textContent=''; e.style.display='none'; } }
  function renderHalkodeForm(){
    if(hkEl('form')) return;
    var c=$('#iyzico-container'); c.classList.add('is-hk');
    var w=document.createElement('div'); w.className='vco-hk'; w.setAttribute('data-hk','form'); w.setAttribute('data-clarity-mask','True');
    w.innerHTML =
      '<div class="vco-row"><div><label class="vco-lbl" for="vco-hk-ad">Ad Soyad *</label>'
      + '<input class="vco-input" id="vco-hk-ad" data-hk="ad" autocomplete="cc-name" placeholder="Kart üzerindeki ad soyad"></div></div>'
      + '<div class="vco-row"><div><label class="vco-lbl" for="vco-hk-no">Kart Numarası *</label>'
      + '<input class="vco-input" id="vco-hk-no" data-hk="no" inputmode="numeric" autocomplete="cc-number" maxlength="23" placeholder="0000 0000 0000 0000"></div></div>'
      + '<div class="vco-row vco-row--2">'
      + '<div><label class="vco-lbl" for="vco-hk-skt">Son Kullanma *</label><input class="vco-input" id="vco-hk-skt" data-hk="skt" inputmode="numeric" autocomplete="cc-exp" maxlength="5" placeholder="AA/YY"></div>'
      + '<div><label class="vco-lbl" for="vco-hk-cvv">CVV *</label><input class="vco-input" id="vco-hk-cvv" data-hk="cvv" inputmode="numeric" autocomplete="cc-csc" maxlength="4" placeholder="000"></div>'
      + '</div>'
      + '<div class="vco-row" data-hk="taksit-satir" style="display:none"><div><label class="vco-lbl" for="vco-hk-taksit">Taksit</label>'
      + '<select id="vco-hk-taksit" data-hk="taksit"><option value="1">Tek çekim</option></select></div></div>'
      + '<button type="button" class="vco-cta" data-hk="ode">Ödeme Yap</button>';
    c.appendChild(w);
    var no=hkEl('no'), skt=hkEl('skt'), cvv=hkEl('cvv');
    no.addEventListener('input', function(){
      var d=hkDigits(no.value).slice(0,19);
      no.value = d.replace(/(\d{4})(?=\d)/g,'$1 ');
      var b=d.slice(0,6);
      if(b.length<6){ hk.bin=''; hkTaksitGizle(); return; }
      if(b!==hk.bin){ hk.bin=b; hkTaksitSorgu(); }
    });
    skt.addEventListener('input', function(){
      var d=hkDigits(skt.value).slice(0,4);
      skt.value = d.length>2 ? d.slice(0,2)+'/'+d.slice(2) : d;
    });
    cvv.addEventListener('input', function(){ cvv.value=hkDigits(cvv.value).slice(0,4); });
    hkEl('ode').addEventListener('click', hkOde);
  }
  function hkTaksitGizle(){ var r=hkEl('taksit-satir'), s=hkEl('taksit'); if(s) s.innerHTML='<option value="1">Tek çekim</option>'; if(r) r.style.display='none'; }
  /* Taksit tablosu yalnız BIN (ilk 6 hane) ile sorulur — tam kart numarası gönderilmez.
     Yalnız müşterinin ödeyeceği TOPLAMI sepet tutarına EŞİT olan seçenekler listelenir:
     vade farklı bir seçenek sipariş tutarından farklı çekim yapar ve dönüşte tutar
     uyuşmazlığına düşer (ödeme alınır, sipariş tamamlanmaz). Bugün hepsi eşit (ölçüldü). */
  function hkTaksitSorgu(){
    var amount=hkTotalKurus(); hk.amountKurus=amount;
    if(!hk.bin || amount<=0){ hkTaksitGizle(); return; }
    var my=++hk.seq;
    fetch(API + '/api/v1/payment/halkode/installments', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ bin: hk.bin, amount: +(amount/100).toFixed(2) }) })
      .then(function(r){ return r.json(); })
      .then(function(d){
        if(my!==hk.seq) return;
        var list = (d && d.ok && d.installments) ? d.installments.filter(function(i){ return Math.round(parseFloat(i.amount_to_be_paid)*100)===amount; }) : [];
        if(!list.length){ hkTaksitGizle(); return; }
        var s=hkEl('taksit'), secili=s ? s.value : '1';
        s.innerHTML = list.map(function(i){
          var n=Number(i.installments_number)||1;
          return '<option value="'+n+'">'+(n===1 ? 'Tek çekim · '+money(amount) : n+' taksit · toplam '+money(amount))+'</option>';
        }).join('');
        if(s.querySelector('option[value="'+secili+'"]')) s.value=secili;
        hkEl('taksit-satir').style.display='block';
      })
      .catch(function(){ if(my===hk.seq) hkTaksitGizle(); });
  }
  function startPaymentHalkode(opts){
    opts = opts || {};
    if(!addrValid()){ if(!opts.auto) status(address1Sorun() || 'Lütfen adres bilgilerini eksiksiz doldurun.'); return; }
    if(!state.carrier){ if(!opts.auto) status('Lütfen kargo firması seçin.'); return; }
    var sig = dataSig();
    if(sig && sig === state.loadedSig){ if(!opts.auto) scrollToPay(); return; }
    status('');
    var gate = $('[data-vco-kart-gate]'); if(gate) gate.style.display='none';
    $('[data-vco-iyzico]').style.display='block';
    $('[data-vco-loading]').style.display='none';
    hkErr('');
    renderHalkodeForm();
    if(hk.bin && hkTotalKurus()!==hk.amountKurus) hkTaksitSorgu(); // tutar değişti → taksit tablosu tazelenir
    state.loadedSig = sig;
    updateCta();
    if(!opts.auto) scrollToPay();
  }
  function hkOde(){
    if(hk.busy) return;
    hkErr('');
    if(!addrValid()){ hkErr(address1Sorun() || 'Lütfen adres bilgilerini eksiksiz doldurun.'); return; }
    if(!state.carrier){ hkErr('Lütfen kargo firması seçin.'); return; }
    var ad=(hkEl('ad').value||'').trim(), no=hkDigits(hkEl('no').value), skt=hkDigits(hkEl('skt').value), cvv=hkDigits(hkEl('cvv').value);
    if(!ad){ hkErr('Kart üzerindeki ad soyadı yazın.'); return; }
    if(no.length<15 || no.length>19 || !hkLuhn(no)){ hkErr('Kart numarasını kontrol edin.'); return; }
    var ay=parseInt(skt.slice(0,2),10), yil=parseInt(skt.slice(2,4),10);
