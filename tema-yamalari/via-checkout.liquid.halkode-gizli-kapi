  function money(kurus){ return (kurus/100).toLocaleString('tr-TR',{minimumFractionDigits:2}) + ' TL'; }
  function moneyTl(tl){ return tl.toLocaleString('tr-TR',{minimumFractionDigits:2}) + ' TL'; }
  function status(msg){ var s=$('[data-vco-status]'); if(s) s.textContent = msg||''; }
