  function vcoSepetUyari(mesaj){
    var box = $('[data-vco-cart]'); if(!box) return;
    var u = document.createElement('div');
    u.setAttribute('data-vco-stok-uyari','');
    u.style.cssText = 'margin:0 0 12px;padding:10px 12px;border:1px solid #f0c36d;background:#fff8e6;border-radius:8px;font-size:13px;color:#7a5b00';
