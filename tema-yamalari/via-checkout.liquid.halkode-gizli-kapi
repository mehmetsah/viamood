     kapatır). Parametresiz her ziyaretçi section ayarındaki sağlayıcıyı görmeye devam eder.
     Herkese açmak için bu kapıya gerek yok: section ayarı kart_gateway = 'halkode'. */
  var HALKODE_KAPI = (function(){
    var q = null;
    try { q = new URLSearchParams(window.location.search).get('halkode'); } catch(e){}
    try {
      if(q==='1') sessionStorage.setItem('vm_halkode_kapi','1');
      else if(q==='0') sessionStorage.removeItem('vm_halkode_kapi');
      return sessionStorage.getItem('vm_halkode_kapi')==='1';
