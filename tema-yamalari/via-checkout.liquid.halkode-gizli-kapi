    var ilByName={}; Object.keys(j.iller).forEach(function(k){ ilByName[_norm(j.iller[k].ad)]=j.iller[k].ad; });
    if(ilRaw && ilByName[_norm(ilRaw)]) out.province=ilByName[_norm(ilRaw)];                 // 1) province geçerli il mi
    if(!out.province && cityRaw && ilByName[_norm(cityRaw)]){ out.province=ilByName[_norm(cityRaw)]; return out; } // 2) Şehir bir il mi
    if(!out.province && cityRaw){                                                            // 3) Şehir bir ilçe mi → il'i bul
      Object.keys(j.iller).some(function(k){
        return j.iller[k].ilceler.some(function(d){ if(_norm(d)===_norm(cityRaw)){ out.province=j.iller[k].ad; out.district=d; return true; } return false; });
      });
