    box.innerHTML = c.items.map(function(it, i){
      var img = thumb(it.image);
      return '<div class="vco-li" data-line="'+(i+1)+'">'+
        '<div class="vco-li__img">'+(img?'<img src="'+img+'" alt="" loading="lazy">':'')+'</div>'+
        '<div class="vco-li__info"><div class="vco-li__title">'+(it.product_title||it.title)+'</div>'+
