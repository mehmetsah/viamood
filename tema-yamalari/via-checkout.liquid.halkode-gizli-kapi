    }).join('');
    loadCrossSell();
  }
  /* ===== MADDE 5 (Yunus, 17 Eyl 2026) — "stoğu 1 olan ürünü sepette artırınca
     sepet boşmuş gibi görünüyor" =====
     ÖLÇÜLDÜ: Shopify /cart/change.js stok aşımında 422 döner ve gövdede `items` YOKTUR:
