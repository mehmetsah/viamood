      [['first_name','fn'],['last_name','ln'],['phone','ph'],['email','em'],['address1','a1'],['postal_code','zip']].forEach(function(p){ var el=f(p[0]); if(el && !el.value && d[p[1]]) el.value=d[p[1]]; });
