{%- comment -%} ============ KAMPANYA BANNER (açılış modalı) ============
  Yunus talebi (8 Ağu 2026): anasayfa ilk açılışta ortada kampanya görseli;
  görsele tıklayınca koleksiyona gider, sağ üstteki X ile kapanır.
  Görseldeki X ÇİZİLİ olduğu için gerçek kapatma butonu ŞEFFAF ve tam onun
  üzerinde duruyor (yüzde hizalı) — ekranda tek X görünür. Ölçüm:
  görselde X dairesinin merkezi soldan %95.37, üstten %6.26 (1448x1086 orijinal).
  Farklı bir görsel yüklenirse "Kapatma butonu" ayarını "Kendi X'imizi çiz"e al.
{%- endcomment -%}
{%- if sec.kampanya_goster -%}
  {%- liquid
    assign kmp_link = sec.kampanya_link | default: '/collections/saklama-kabi'
    # TEKRAR SIKLIĞI — 'session' (aynı ziyaret) | 'gun' (24 saat) | 'her-acilis'
    # Tema Editörü'nden de seçilebilir; aşağısı yalnızca varsayılandır.
    assign kmp_siklik = sec.kampanya_siklik | default: 'session'
    assign kmp_gecikme = sec.kampanya_gecikme | default: 1000
    assign kmp_kapatma = sec.kampanya_kapatma | default: 'gomulu'
  -%}
  <div class="vmk-overlay" id="vmk-overlay" role="dialog" aria-modal="true"
       aria-label="Kampanya duyurusu" hidden
       data-vmk-siklik="{{ kmp_siklik }}" data-vmk-gecikme="{{ kmp_gecikme }}">
    <div class="vmk-box">
      <a class="vmk-link" href="{{ kmp_link }}" aria-label="Kampanyayı incele — avantajlı saklama kabı setleri">
        {%- if sec.kampanya_gorsel -%}
          <img class="vmk-img" src="{{ sec.kampanya_gorsel | image_url: width: 1200 }}"
               alt="{{ sec.kampanya_alt | default: 'Siteye özel fiyat — avantajlı setleri kaçırma' | escape }}"
               width="{{ sec.kampanya_gorsel.width }}" height="{{ sec.kampanya_gorsel.height }}">
        {%- else -%}
          <picture>
            <source srcset="{{ 'via-kampanya-banner.webp' | asset_url }}" type="image/webp">
            <img class="vmk-img" src="{{ 'via-kampanya-banner.jpg' | asset_url }}"
                 alt="{{ sec.kampanya_alt | default: 'Siteye özel fiyat — avantajlı saklama kabı setlerini kaçırma' | escape }}"
                 width="1200" height="900" fetchpriority="low" decoding="async">
          </picture>
        {%- endif -%}
      </a>
      <button type="button" class="vmk-close{% if kmp_kapatma == 'kendi' %} vmk-kendi{% endif %}"
              aria-label="Kampanya duyurusunu kapat">
        <svg class="vmk-x" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M7 7 L17 17 M17 7 L7 17" stroke="currentColor" stroke-width="3.2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
{%- endif -%}

{% style %}
  .vmh2{
    --vmh2-bg:#f7f3ed; --vmh2-paper:#fffdf9; --vmh2-ink:#22211f; --vmh2-muted:#716d67;
    --vmh2-line:#e7dfd5; --vmh2-orange:#f06436; --vmh2-orange-dark:#d74d23;
    --vmh2-sand:#eadfce; --vmh2-green:#5e725d; --vmh2-radius:28px;
    --vmh2-shadow:0 24px 60px rgba(49,38,28,.12);
    --vmh2-container:min(1440px, calc(100% - 40px));
    font-family:"DM Sans",sans-serif !important; color:var(--vmh2-ink); background:var(--vmh2-bg);
    overflow-x:hidden;
  }
  .vmh2 *{box-sizing:border-box}
  /* Tema global tipografisi (Inter) bölüm fontlarını eziyor → zorla */
  .vmh2 p,.vmh2 a,.vmh2 span,.vmh2 small,.vmh2 strong,.vmh2 button,.vmh2 input,.vmh2 h3{font-family:"DM Sans",sans-serif !important}
  .vmh2 img{display:block;width:100%;height:100%;object-fit:cover}
  .vmh2 a{text-decoration:none;color:inherit}
  .vmh2 h1,.vmh2 h2,.vmh2 h3,.vmh2 p{margin-top:0}

  .vmh2-category-rail{background:var(--vmh2-paper);border-bottom:1px solid var(--vmh2-line)}
  .vmh2-category-wrap{width:var(--vmh2-container);margin:auto;display:flex;justify-content:center;gap:18px;padding:18px 0 22px;overflow:auto;scrollbar-width:none}
  .vmh2-category-wrap::-webkit-scrollbar{display:none}
  .vmh2-quick-category{min-width:138px;display:flex;align-items:center;gap:12px;padding:10px 14px 10px 10px;border-radius:999px;background:#f7f0e5;transition:.25s ease;white-space:nowrap}
  .vmh2-quick-category:hover{background:#efe0d0;transform:translateY(-2px)}
  .vmh2-quick-icon{width:48px;height:48px;border-radius:50%;display:grid;place-items:center;background:var(--vmh2-paper);color:var(--vmh2-orange);box-shadow:0 8px 18px rgba(240,100,54,.12);font-size:20px;overflow:hidden}
  .vmh2-quick-icon img{width:100%;height:100%;object-fit:cover;border-radius:50%}
  .vmh2-quick-category span:last-child{font-size:13px;font-weight:700}

  .vmh2-hero{width:var(--vmh2-container);min-height:740px;margin:28px auto 0;position:relative;overflow:hidden;border-radius:36px;box-shadow:var(--vmh2-shadow);background:#c9b8a2}
  .vmh2-hero-media{position:absolute;inset:0}
  .vmh2-hero-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center;opacity:0;transition:opacity .9s ease}
  .vmh2-hero-media img.vmh2-hm-gorunur{opacity:1}
  .vmh2-hs-fade{transition:opacity .35s ease}
  .vmh2-solgun{opacity:0 !important}
  .vmh2-hs-editarea{position:absolute;inset:0;z-index:4;pointer-events:none}
  .vmh2-hs-editarea.aktif{pointer-events:auto}
  .vmh2-hs-dots{position:absolute;left:70px;bottom:34px;z-index:6;display:flex;gap:8px}
  /* Banner modu: görsel kendi tasarımını taşıyor → metin/gradyan/rozet kapatılır,
     yükseklik 3:2'ye sabitlenir (banner'lar 4:3 ve 3:2; cover ile kırpma ~%6 kalır). */
  /* Banner modu oranı: 11 Eyl 2026'da gelen yeni banner'lar 1600x707 (~2.26:1).
     Eskiden 3/2 (1.5) idi; bu oranda yeni görsellerin SOL ve SAĞ kenarındaki
     ürünler `object-fit:cover` ile kırpılıyordu. Oran görselin kendi oranına
     çekildi → kırpma yok. Yeni banner setinde oran değişirse burayı güncelle. */
  .vmh2-hero--banner{min-height:0;aspect-ratio:1600/707;background:#14110e}

  /* ── Hero okları (prev/next) ──────────────────────────────────────────────
     Dokunma hedefi 48x48 (min 44 şartı). Kontrast: koyu yarı saydam daire +
     beyaz çizgi ikon → açık ve koyu banner'ların ikisinde de okunur.
     z-index banner modundaki tam alan linkinin (z-index:4) ÜSTÜNDE. */
  .vmh2-hs-ok{
    position:absolute; top:50%; transform:translateY(-50%);
    z-index:6; width:48px; height:48px; padding:0;
    display:grid; place-items:center;
    border:0; border-radius:50%; cursor:pointer;
    color:#fff; background:rgba(20,17,14,.42);
    -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px);
    box-shadow:0 2px 10px rgba(0,0,0,.28);
    transition:background .15s ease, transform .15s ease;
    -webkit-tap-highlight-color:transparent;
  }
  .vmh2-hs-ok svg{width:24px;height:24px;display:block}
  .vmh2-hs-ok:hover{background:rgba(20,17,14,.64)}
  .vmh2-hs-ok:active{transform:translateY(-50%) scale(.94)}
  .vmh2-hs-ok:focus-visible{outline:3px solid #fff;outline-offset:2px}
  .vmh2-hs-ok--geri{left:14px}
  .vmh2-hs-ok--ileri{right:14px}
  @media (max-width:749px){
    .vmh2-hs-ok{width:44px;height:44px}
    .vmh2-hs-ok svg{width:21px;height:21px}
    .vmh2-hs-ok--geri{left:8px}
    .vmh2-hs-ok--ileri{right:8px}
  }
  @media (prefers-reduced-motion:reduce){ .vmh2-hs-ok{transition:none} }
  .vmh2-hero--banner .vmh2-hero-media::after{display:none}
  .vmh2-hero--banner .vmh2-hero-content{display:none}
  .vmh2-hero--banner .vmh2-hero-badge{display:none}
  .vmh2-hero-link{position:absolute;inset:0;z-index:4;display:block}
  @media (max-width:749px){ .vmh2-hero--banner{aspect-ratio:1600/707} .vmh2-hero--banner .vmh2-hs-dots{left:50%;transform:translateX(-50%);bottom:14px} }
  .vmh2-hs-dots button{width:10px;height:10px;border-radius:50%;border:0;padding:0;background:rgba(255,255,255,.45);cursor:pointer;transition:.2s}
  .vmh2-hs-dots button.aktif{background:#fff;transform:scale(1.25)}
  @media(max-width:720px){.vmh2-hs-dots{left:20px;bottom:14px}}
  .vmh2-hero-media img{filter:saturate(.92) contrast(1.02)}
  .vmh2-hero-media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,17,14,.68) 0%,rgba(20,17,14,.36) 40%,rgba(20,17,14,.05) 70%)}
  .vmh2-hero-content{position:relative;z-index:2;width:min(660px,90%);min-height:740px;padding:88px 70px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;color:#fff}
  .vmh2-eyebrow{display:inline-flex;align-items:center;gap:10px;padding:9px 14px;border:1px solid rgba(255,255,255,.45);border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;background:rgba(255,255,255,.08);backdrop-filter:blur(8px)}
  .vmh2-eyebrow::before{content:"";width:7px;height:7px;border-radius:50%;background:#ff8a63}
  .vmh2-hero h1{font-family:"Playfair Display",serif !important;font-size:clamp(54px,6.3vw,102px);line-height:.95;letter-spacing:-.045em;margin:24px 0;max-width:760px;color:#fff !important}
  .vmh2-hero h1 em{font-weight:600;color:#ffd8ca;display:inline;font-family:inherit !important;font-size:inherit;font-style:italic}
  .vmh2-hero p{font-size:18px;line-height:1.65;color:rgba(255,255,255,.86) !important;max-width:520px}
  .vmh2-hero-actions{display:flex;gap:14px;margin-top:18px;flex-wrap:wrap}
  .vmh2-btn[hidden]{display:none !important} /* hidden attr'ı display:inline-flex'e ezdirme (slayt-CTA boş blob fix) */
  .vmh2-btn{min-height:54px;padding:0 25px;border-radius:999px;border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:700;cursor:pointer;transition:.22s ease;font-family:inherit}
  .vmh2-btn-primary{background:var(--vmh2-orange);color:#fff;box-shadow:0 16px 30px rgba(240,100,54,.28)}
  .vmh2-btn-primary:hover{background:var(--vmh2-orange-dark);transform:translateY(-2px)}
  .vmh2-btn-light{background:#fff;color:var(--vmh2-ink) !important}
  .vmh2-btn-light:hover{transform:translateY(-2px);background:#f7efe6}
  .vmh2-btn-ghost{border-color:#d5cabe;color:var(--vmh2-ink)}
  .vmh2-hero-badge{position:absolute;right:42px;bottom:42px;z-index:3;width:170px;height:170px;border-radius:50%;display:grid;place-items:center;text-align:center;padding:24px;background:rgba(255,253,249,.93);color:var(--vmh2-ink);box-shadow:0 18px 44px rgba(0,0,0,.2);transform:rotate(7deg)}
  .vmh2-hero-badge strong{font-family:"Playfair Display",serif !important;font-size:28px;color:var(--vmh2-orange)}
  .vmh2-hero-badge small{display:block;font-size:12px;line-height:1.45;color:var(--vmh2-muted)}

  .vmh2-section{width:var(--vmh2-container);margin:108px auto}
  .vmh2-section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:34px}
  .vmh2-section-kicker{font-size:12px;letter-spacing:.13em;text-transform:uppercase;font-weight:800;color:var(--vmh2-orange);margin-bottom:10px}
  .vmh2-section h2{font-family:"Playfair Display",serif !important;font-size:clamp(42px,5vw,72px);line-height:1.03;letter-spacing:-.035em;margin-bottom:0}
  .vmh2-section-note{max-width:420px;color:var(--vmh2-muted);line-height:1.7}

  .vmh2-category-grid{display:grid;grid-template-columns:1.2fr .8fr .8fr;grid-template-rows:360px 360px;gap:20px}
  .vmh2-category-card{position:relative;overflow:hidden;border-radius:var(--vmh2-radius);background:#ddd;box-shadow:0 16px 40px rgba(44,33,23,.08)}
  .vmh2-category-card:first-child{grid-row:1/3}
  .vmh2-category-card:nth-child(4){grid-column:2/4}
  .vmh2-category-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 42%,rgba(18,15,12,.68) 100%)}
  .vmh2-category-card img{transition:transform .7s cubic-bezier(.2,.7,.2,1)}
  .vmh2-category-card:hover img{transform:scale(1.06)}
  .vmh2-category-copy{position:absolute;z-index:2;left:28px;right:28px;bottom:26px;color:#fff}
  .vmh2-category-copy small{font-size:12px;letter-spacing:.1em;text-transform:uppercase;opacity:.8;color:#fff !important}
  .vmh2-category-copy h3{font-family:"Playfair Display",serif !important;font-size:34px;margin:6px 0 0;color:#fff !important}

  .vmh2-benefit-strip{width:var(--vmh2-container);margin:40px auto 0;padding:26px 30px;display:grid;grid-template-columns:repeat(4,1fr);gap:22px;border-radius:24px;background:var(--vmh2-ink);color:#fff}
  .vmh2-benefit{display:flex;gap:14px;align-items:center;border-right:1px solid rgba(255,255,255,.12)}
  .vmh2-benefit:last-child{border-right:0}
  .vmh2-benefit-icon{width:48px;height:48px;border-radius:16px;display:grid;place-items:center;background:rgba(255,255,255,.1);color:#ffd8ca;font-size:20px;flex:none}
  .vmh2-benefit strong{display:block;font-size:14px}
  .vmh2-benefit span:last-child{display:block;margin-top:4px;font-size:12px;color:rgba(255,255,255,.62)}

  .vmh2-products{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  /* ==== Yeni Gelenler CAROUSEL (block.settings.slider) — Yunus referansı ====
     ok + otomatik 3sn + sonsuz döngü + parmakla sürükle. Kart tasarımı korunur;
     yalnızca liste bir raya (track) dönüşür. Görünen kart --vm-vis'ten hesaplanır. */
  .vmh2 .vmh2-products--slider{--vm-vis:4;--vm-gap:22px;position:static}
  @media(max-width:1200px){.vmh2 .vmh2-products--slider{--vm-vis:3}}
  @media(max-width:900px) {.vmh2 .vmh2-products--slider{--vm-vis:3;--vm-gap:14px}}
  @media(max-width:640px) {.vmh2 .vmh2-products--slider{--vm-vis:2;--vm-gap:14px}}
  /* JS sarmalamadan önce: tek satır göster, taşmayı gizle (FOUC engelle) */
  .vmh2 .vmh2-products--slider:not([data-vm-slider="1"]){display:flex;flex-wrap:nowrap;gap:var(--vm-gap);overflow:hidden;grid-template-columns:none}
  .vmh2 .vmh2-products--slider:not([data-vm-slider="1"])>*{flex:0 0 calc((100% - (var(--vm-vis) - 1) * var(--vm-gap)) / var(--vm-vis));min-width:0}
  /* JS sonrası iskelet */
  .vmh2 .vmh2-slider{position:relative}
  .vmh2 .vmh2-slider__viewport{overflow:hidden;padding:6px 0 14px;margin:-6px 0 -14px}
  .vmh2 .vmh2-slider .vmh2-slider__track{display:flex !important;flex-wrap:nowrap !important;gap:var(--vm-gap) !important;grid-template-columns:none !important;margin:0 !important;transition:transform .55s cubic-bezier(.22,.61,.36,1);will-change:transform;touch-action:pan-y;cursor:grab;-webkit-user-select:none;user-select:none}
  .vmh2 .vmh2-slider .vmh2-slider__track.is-dragging{cursor:grabbing;transition:none}
  .vmh2 .vmh2-slider .vmh2-slider__track>*{flex:0 0 calc((100% - (var(--vm-vis) - 1) * var(--vm-gap)) / var(--vm-vis)) !important;max-width:calc((100% - (var(--vm-vis) - 1) * var(--vm-gap)) / var(--vm-vis)) !important;min-width:0 !important}
  .vmh2 .vmh2-slider .vmh2-slider__track img{-webkit-user-drag:none;user-drag:none;pointer-events:none}
  /* oklar */
  .vmh2 .vmh2-slider__nav{position:absolute;top:calc(50% - 30px);transform:translateY(-50%);z-index:5;width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid rgba(45,33,24,.12);background:rgba(255,255,255,.96);color:#2d2118;font-size:22px;line-height:1;cursor:pointer;box-shadow:0 6px 18px rgba(45,33,24,.14);transition:.2s ease;padding:0}
  .vmh2 .vmh2-slider__nav:hover{background:#2d2118;color:#fff;border-color:transparent}
  .vmh2 .vmh2-slider__nav:focus-visible{outline:2px solid var(--vmh2-accent,#e1691f);outline-offset:3px}
  .vmh2 .vmh2-slider__nav--prev{left:-10px}
  .vmh2 .vmh2-slider__nav--next{right:-10px}
  @media(min-width:1400px){.vmh2 .vmh2-slider__nav--prev{left:-22px}.vmh2 .vmh2-slider__nav--next{right:-22px}}
  @media(max-width:640px){.vmh2 .vmh2-slider__nav{width:36px;height:36px;font-size:18px;top:calc(50% - 40px)}.vmh2 .vmh2-slider__nav--prev{left:-4px}.vmh2 .vmh2-slider__nav--next{right:-4px}}
  @media(prefers-reduced-motion:reduce){.vmh2 .vmh2-slider .vmh2-slider__track{transition-duration:.01ms}}
  /* 2026-08-08 MOBİL FIX — assets/via-mobile-app.css içindeki genel yardımcı kural
     (@media max-width:749px → [class*="slider__track"]{overflow-x:auto!important;
     scroll-snap-type;padding:6px 12px!important}) bizim ray'imize de uyuyordu.
     overflow-x:auto ray'i kendi 342px'lik kutusuyla kırpan bir kaydırma kutusuna
     çeviriyor; carousel ise içeriği translateX ile taşıdığı için görünürdeki tüm
     kartlar kırpma alanının dışında kalıyor → mobilde bölüm bomboş görünüyordu.
     Yalnızca bu carousel muaf tutulur; diğer slider'lar genel kuralda kalır. */
  @media(max-width:749px){
    .vmh2 .vmh2-slider .vmh2-slider__track{overflow:visible !important;scroll-snap-type:none !important;padding:0 !important}
    .vmh2 .vmh2-slider .vmh2-slider__track>*{scroll-snap-align:none !important}
  }
