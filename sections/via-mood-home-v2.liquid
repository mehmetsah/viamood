<script>
  (function(){
    // "Her ziyarette karışık" ürün vitrinleri
    document.querySelectorAll('.vmh2 [data-vmh2-random]').forEach(function(g){
      var n = parseInt(g.getAttribute('data-vmh2-random')) || 4;
      var cards = [].slice.call(g.querySelectorAll('[data-vmh2-pool]'));
      for (var i = cards.length - 1; i > 0; i--) { var j = Math.floor(Math.random() * (i + 1)); var t = cards[i]; cards[i] = cards[j]; cards[j] = t; }
      cards.forEach(function(c, i){ c.hidden = i >= n; g.appendChild(c); });
    });
    var items = document.querySelectorAll('.vmh2 .vmh2-reveal');
    if (!('IntersectionObserver' in window)) { items.forEach(function(i){ i.classList.add('vmh2-visible'); }); return; }
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){ if(e.isIntersecting) e.target.classList.add('vmh2-visible'); });
    },{threshold:.12});
    items.forEach(function(i){ obs.observe(i); });
  })();
</script>

<script>
/* ==== Yeni Gelenler CAROUSEL — Yunus referans mekanizması ====
   .vmh2-products--slider listesini sarmalar, ok ekler, otomatik 3sn kaydırır,
   sonsuz döngü + parmakla sürükleme. Bağımlılık yok, kart markup'ına dokunmaz. */
(function () {
  'use strict';
  var CFG = { selector: '.vmh2 .vmh2-products--slider', autoplay: true, interval: 3000, threshold: 8 };
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function build(list) {
    if (list.dataset.vmSlider === '1') return;
    list.dataset.vmSlider = '1';
    var originals = Array.prototype.slice.call(list.children);
    var total = originals.length;
    if (total < 2) return;

    var root = document.createElement('div');
    root.className = 'vmh2-slider';
    root.setAttribute('role', 'region');
    root.setAttribute('aria-roledescription', 'ürün karuseli');
    root.setAttribute('aria-label', 'Yeni gelen ürünler');
    root.tabIndex = 0;
    var viewport = document.createElement('div');
    viewport.className = 'vmh2-slider__viewport';
    list.parentNode.insertBefore(root, list);
    root.appendChild(viewport);
    viewport.appendChild(list);
    list.classList.add('vmh2-slider__track');

    var prevBtn = makeNav('prev', 'Önceki ürünler', '‹');
    var nextBtn = makeNav('next', 'Sonraki ürünler', '›');
    root.appendChild(prevBtn);
    root.appendChild(nextBtn);

    addCopy(); addCopy();
    function addCopy() {
      for (var i = 0; i < total; i++) {
        var c = originals[i].cloneNode(true);
        c.setAttribute('aria-hidden', 'true');
        var links = c.querySelectorAll('a');
        for (var j = 0; j < links.length; j++) links[j].tabIndex = -1;
        list.appendChild(c);
      }
    }

    var index = total, step = 0, timer = null;
    var hovered = false, focused = false, dragging = false, moved = false, capturedId = null;
    var startX = 0, startY = 0, startTx = 0, currentTx = 0, blockClick = false;

    measure(); place(false); bind(); start();

    function measure() {
      var first = list.children[0];
      if (!first) return;
      var cs = getComputedStyle(list);
      var gap = parseFloat(cs.columnGap);
      if (isNaN(gap)) gap = parseFloat(cs.gap) || 0;
      step = first.getBoundingClientRect().width + gap;
    }
    function place(animate) {
      var x = -index * step;
      if (!isFinite(x)) return;
      if (animate) { list.style.transform = 'translate3d(' + x + 'px,0,0)'; }
      else {
        var t = list.style.transition;
        list.style.transition = 'none';
        list.style.transform = 'translate3d(' + x + 'px,0,0)';
        void list.offsetWidth;
        list.style.transition = t;
      }
    }
    function goTo(i) { index = i; place(true); }
    function next() { goTo(index + 1); }
    function prev() { goTo(index - 1); }
    function normalize() {
      var n = index;
      while (n >= total * 2) n -= total;
      while (n < total) n += total;
      if (n !== index) { index = n; place(false); }
    }
    function start() {
      stop();
      if (!CFG.autoplay || reduceMotion) return;
      timer = setInterval(function () {
        if (hovered || focused || dragging || document.hidden) return;
        next();
      }, CFG.interval);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }

    function bind() {
      nextBtn.addEventListener('click', function () { next(); });
      prevBtn.addEventListener('click', function () { prev(); });
      root.addEventListener('mouseenter', function () { hovered = true; });
      root.addEventListener('mouseleave', function () { hovered = false; });
      root.addEventListener('focusin', function (e) {
        try { focused = e.target.matches(':focus-visible'); } catch (err) { focused = true; }
      });
      root.addEventListener('focusout', function () { focused = false; });
      root.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') { e.preventDefault(); next(); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }
      });
      list.addEventListener('transitionend', function (e) {
        if (e.target !== list || e.propertyName !== 'transform') return;
        normalize();
      });
      viewport.addEventListener('pointerdown', onDown);
      viewport.addEventListener('pointermove', onMove);
      viewport.addEventListener('pointerup', onUp);
      viewport.addEventListener('pointercancel', onUp);
      root.addEventListener('click', function (e) {
        if (!blockClick) return;
        blockClick = false;
        e.preventDefault();
        e.stopPropagation();
      }, true);
      var raf = null;
      function onResize() {
        if (raf) cancelAnimationFrame(raf);
        raf = requestAnimationFrame(function () { measure(); place(false); });
      }
      window.addEventListener('resize', onResize);
      window.addEventListener('orientationchange', onResize);
      window.addEventListener('load', onResize);
      if (window.ResizeObserver) new ResizeObserver(onResize).observe(viewport);
      document.addEventListener('visibilitychange', function () { if (!document.hidden) start(); });
    }
    function onDown(e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true; moved = false;
      capturedId = null;
      startX = e.clientX; startY = e.clientY;
      startTx = -index * step; currentTx = startTx;
      list.classList.add('is-dragging');
      /* DİKKAT: burada setPointerCapture ÇAĞIRMA. Pointer capture aktifken tarayıcı
         sonraki `click`i yakalayan elemana (viewport) yönlendiriyor → kartın <a>'sına
         hiç ulaşmıyordu: "Yeni Gelenler"de ürüne tıklama ve karttaki "+" ölüydü
         (Yunus, 12 Ağu). Capture yalnız GERÇEK sürükleme başlayınca alınır (onMove). */
    }
    function onMove(e) {
      if (!dragging) return;
      var dx = e.clientX - startX, dy = e.clientY - startY;
      if (!moved) {
        if (Math.abs(dx) < CFG.threshold) return;
        if (Math.abs(dy) > Math.abs(dx)) { cancel(); return; }
        moved = true;
        // Sürükleme kesinleşti → parmak viewport dışına çıksa da takip et.
        try { viewport.setPointerCapture(e.pointerId); capturedId = e.pointerId; } catch (err) {}
      }
      if (e.cancelable) e.preventDefault();
      currentTx = startTx + dx;
      list.style.transform = 'translate3d(' + currentTx + 'px,0,0)';
    }
    function onUp() {
      if (!dragging) return;
      dragging = false;
      releaseCapture();
      list.classList.remove('is-dragging');
      if (!moved || !step) { start(); return; }
      var dx = currentTx - startTx;
      var target = Math.round(-currentTx / step);
      if (target === index && Math.abs(dx) > step * 0.12) {
        target = index + (dx < 0 ? 1 : -1);
      }
      blockClick = true;
      setTimeout(function () { blockClick = false; }, 400);
      goTo(target); start();
    }
    function releaseCapture() {
      if (capturedId == null) return;
      try { viewport.releasePointerCapture(capturedId); } catch (err) {}
      capturedId = null;
    }
    function cancel() {
      dragging = false; moved = false;
      releaseCapture();
      list.classList.remove('is-dragging');
      place(false);
    }
    function makeNav(dir, label, glyph) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'vmh2-slider__nav vmh2-slider__nav--' + dir;
      b.setAttribute('aria-label', label);
      b.textContent = glyph;
      return b;
    }
  }
  function init() {
    var lists = document.querySelectorAll(CFG.selector);
    for (var i = 0; i < lists.length; i++) build(lists[i]);
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); }
  else { init(); }
})();
</script>

{%- comment -%} Kampanya banner davranışı — 2026-08-08 {%- endcomment -%}
<script>
  (function(){
    var ov = document.getElementById('vmk-overlay');
    if (!ov) return;
    var ANAHTAR = 'vmk-kampanya-kapali';
    var siklik  = ov.getAttribute('data-vmk-siklik') || 'session';
    var gecikme = parseInt(ov.getAttribute('data-vmk-gecikme'), 10);
    if (isNaN(gecikme) || gecikme < 0) gecikme = 1000;
    var btn = ov.querySelector('.vmk-close');
    var sonOdak = null;

    function gizliMi(){
      try {
        if (siklik === 'her-acilis') return false;
        if (siklik === 'gun') {
          var t = parseInt(window.localStorage.getItem(ANAHTAR), 10);
          return !!t && (new Date().getTime() - t) < 86400000;
        }
        return window.sessionStorage.getItem(ANAHTAR) === '1';
      } catch (e) { return false; }  /* çerez/depolama kapalıysa banner yine çalışsın */
    }
    function isaretle(){
      try {
        if (siklik === 'gun') window.localStorage.setItem(ANAHTAR, String(new Date().getTime()));
        else if (siklik !== 'her-acilis') window.sessionStorage.setItem(ANAHTAR, '1');
      } catch (e) {}
    }
    function esc(e){
      if (e.key === 'Escape' || e.key === 'Esc' || e.keyCode === 27) { e.preventDefault(); kapat(); }
    }
    function ac(){
      if (gizliMi()) return;
      sonOdak = document.activeElement;
      ov.hidden = false;
      /* reflow — geçişin tetiklenmesi için. rAF arka plan sekmede çalışmaz, kullanma. */
      void ov.offsetWidth;
      ov.classList.add('vmk-acik');
      if (btn) { try { btn.focus({ preventScroll: true }); } catch (e) { btn.focus(); } }
      document.addEventListener('keydown', esc);
    }
    function kapat(){
      isaretle();
      ov.classList.remove('vmk-acik');
      document.removeEventListener('keydown', esc);
      setTimeout(function(){ ov.hidden = true; }, 420);
      if (sonOdak && sonOdak.focus) { try { sonOdak.focus({ preventScroll: true }); } catch (e) {} }
    }

    if (btn) btn.addEventListener('click', kapat);
    /* overlay'in boşluğuna tıklama kapatır; kutunun içi kapatmaz */
    ov.addEventListener('click', function(e){ if (e.target === ov) kapat(); });
    /* görsele tıklayıp koleksiyona giden kullanıcıya geri dönünce tekrar gösterme */
    var link = ov.querySelector('.vmk-link');
    if (link) link.addEventListener('click', isaretle);

    if (gizliMi()) return;
    if (document.readyState === 'complete') setTimeout(ac, gecikme);
    else window.addEventListener('load', function(){ setTimeout(ac, gecikme); });
  })();
</script>

