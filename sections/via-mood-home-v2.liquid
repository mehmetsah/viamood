  </section>
  {%- endif -%}

  {%- comment -%} ============ MARKALARIMIZ (V2 carousel — kutulu; yorumların altı) ============ {%- endcomment -%}
  {%- assign marka_var = false -%}
  {%- for block in section.blocks -%}{%- if block.type == "marka" -%}{%- assign marka_var = true -%}{%- endif -%}{%- endfor -%}
  {%- if marka_var -%}
  <section class="vmh2-section vmb" aria-label="Markalarımız">
    <div class="vmb-head">
      <p class="vmb-eyebrow">{{ sec.marka_kicker | default: "Güvenilir iş ortakları" }}</p>
      <h2>{{ sec.marka_baslik | default: "Markalarımız." }}</h2>
    </div>
    <div class="vmb-carousel">
      <button type="button" class="vmb-btn vmb-btn-prev" aria-label="Önceki markalar">‹</button>
      <button type="button" class="vmb-btn vmb-btn-next" aria-label="Sonraki markalar">›</button>
      <div class="vmb-viewport">
        <div class="vmb-track">
          {%- for block in section.blocks -%}
            {%- if block.type == "marka" -%}
              {%- if block.settings.link != blank -%}<a class="vmb-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<span class="vmb-card" {{ block.shopify_attributes }}>{%- endif -%}
                <span class="vmb-logo">
                  {%- if block.settings.gorsel -%}
                    <img src="{{ block.settings.gorsel | image_url: width: 400 }}"{% if block.settings.acik_renk %} class="is-light"{% endif %} alt="{{ block.settings.isim | escape }}" loading="lazy">
                  {%- else -%}
                    <span class="vmb-ph">{{ block.settings.isim | default: "Marka" | escape }}</span>
                  {%- endif -%}
                </span>
              {%- if block.settings.link != blank -%}</a>{%- else -%}</span>{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
    <div class="vmb-dots" role="tablist" aria-label="Marka sayfaları"></div>
  </section>
  <style>
    .vmb{background:#f7f4ee;box-shadow:0 0 0 100vmax #f7f4ee;clip-path:inset(0 -100vmax);padding-top:56px;padding-bottom:56px}
    .vmb-head{text-align:center;margin-bottom:36px}
    .vmb-head::after{content:"";display:block;width:64px;height:2px;background:var(--vmh2-accent,#e1691f);margin:18px auto 0;border-radius:2px}
    .vmb-eyebrow{font-size:13px;font-weight:600;letter-spacing:.04em;color:var(--vmh2-accent,#e1691f);margin-bottom:8px}
    .vmb-carousel{position:relative}
    .vmb-viewport{overflow:hidden}
    .vmb-track{display:flex;transition:transform .45s cubic-bezier(.4,0,.2,1);will-change:transform}
    .vmb-btn{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:44px;height:44px;border-radius:50%;border:none;background:#fff;color:var(--vmh2-ink,#3a2c22);font-size:20px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(90,60,30,.15);transition:all .2s ease}
    .vmb-btn-prev{left:-14px}
    .vmb-btn-next{right:-14px}
    .vmb-btn:hover{background:var(--vmh2-accent,#e1691f);color:#fff}
    .vmb-card{flex:0 0 16.6667%;padding:12px 14px;text-decoration:none;color:inherit;display:block!important;min-width:0}
    .vmb .vmb-card .vmb-logo{width:100%!important;max-width:100%!important;aspect-ratio:1/1!important;display:flex!important;align-items:center;justify-content:center;background:#fff;border-radius:16px;padding:22px;box-shadow:0 10px 24px rgba(90,60,30,.12),0 2px 6px rgba(90,60,30,.06);transition:transform .25s ease,box-shadow .25s ease;overflow:hidden;box-sizing:border-box}
    .vmb-card:hover .vmb-logo{transform:translateY(-5px);box-shadow:0 18px 34px rgba(90,60,30,.16),0 3px 8px rgba(90,60,30,.07)}
    .vmb .vmb-card .vmb-logo img{width:100%!important;height:100%!important;max-width:100%!important;max-height:100%!important;object-fit:contain!important;aspect-ratio:auto!important;display:block;border-radius:0}
    .vmb .vmb-card .vmb-logo img.is-light{filter:invert(.82) sepia(.12)}
    .vmb-ph{font-size:13px;font-weight:700;color:#c4b49e;text-align:center}
    .vmb-dots{display:flex;justify-content:center;gap:8px;margin-top:30px}
    .vmb-dot{width:8px;height:8px;border-radius:50%;border:none;background:#dcccb9;cursor:pointer;padding:0;transition:all .25s ease}
    .vmb-dot.is-active{width:22px;border-radius:99px;background:var(--vmh2-accent,#e1691f)}
    @media (max-width:1200px){.vmb-card{flex:0 0 25%;padding:12px 12px}}
    @media (max-width:900px){.vmb-card{flex:0 0 33.3333%}}
    @media (max-width:680px){.vmb-card{flex:0 0 50%}.vmb-btn-prev{left:-6px}.vmb-btn-next{right:-6px}}
    @media (max-width:420px){.vmb-card{flex:0 0 100%}}
    @media (prefers-reduced-motion:reduce){.vmb-track{transition:none}}
  </style>
  <script>
  (function(){
    var AUTO_MS = 1500;
    function perView(){ var w=window.innerWidth; if(w<=420)return 1; if(w<=680)return 2; if(w<=900)return 3; if(w<=1200)return 4; return 6; }
    function initCarousel(root){
      var track=root.querySelector('.vmb-track'), prev=root.querySelector('.vmb-btn-prev'), next=root.querySelector('.vmb-btn-next');
      var dotsC=root.parentElement.querySelector('.vmb-dots');
      var realCount=track.children.length; if(!realCount) return;
      var index=0, timer=null, animating=false;
      for(var i=0;i<realCount;i++){ track.appendChild(track.children[i].cloneNode(true)); }
      function cardW(){ return track.children[0].offsetWidth; }
      function setX(noAnim){ if(noAnim) track.style.transition='none'; track.style.transform='translateX('+(-index*cardW())+'px)'; if(noAnim){ void track.offsetHeight; track.style.transition=''; } }
      function renderDots(){
        var pv=perView(), pages=Math.max(1,Math.ceil(realCount/pv)), current=Math.floor((index%realCount)/pv)%pages;
        dotsC.innerHTML='';
        for(var i=0;i<pages;i++){ var d=document.createElement('button'); d.type='button'; d.className='vmb-dot'+(i===current?' is-active':''); d.setAttribute('aria-label',(i+1)+'. sayfa');
          (function(idx){ d.addEventListener('click',function(){ index=idx*perView(); setX(false); renderDots(); restart(); }); })(i); dotsC.appendChild(d); }
        dotsC.style.display=(pages===1)?'none':'flex';
      }
      function stepNext(){ if(animating)return; animating=true; index++; setX(false); }
      function stepPrev(){ if(animating)return; animating=true; if(index<=0){ index=realCount; setX(true); } index--; setX(false); }
      track.addEventListener('transitionend',function(){ animating=false; if(index>=realCount){ index=index-realCount; setX(true); } renderDots(); });
      function restart(){ clearInterval(timer); timer=setInterval(stepNext,AUTO_MS); }
      next.addEventListener('click',function(){ stepNext(); restart(); });
      prev.addEventListener('click',function(){ stepPrev(); restart(); });
      root.addEventListener('mouseenter',function(){ clearInterval(timer); });
      root.addEventListener('mouseleave',restart);
      var startX=null;
      track.addEventListener('touchstart',function(e){ startX=e.touches[0].clientX; clearInterval(timer); },{passive:true});
      track.addEventListener('touchend',function(e){ if(startX!==null){ var dx=e.changedTouches[0].clientX-startX; if(dx<-40)stepNext(); else if(dx>40)stepPrev(); startX=null; } restart(); },{passive:true});
      var rid; window.addEventListener('resize',function(){ clearTimeout(rid); rid=setTimeout(function(){ setX(true); renderDots(); },120); });
      setX(true); renderDots(); restart();
    }
    document.querySelectorAll('.vmb .vmb-carousel').forEach(initCarousel);
  })();
  </script>
  {%- endif -%}

  {%- comment -%} ============ BÜLTEN ============ {%- endcomment -%}
