{%- comment -%}
  Via Mood — Anasayfa V2 ("homepage-redesign" HTML tasarımının birebir portu).
  V1 (via-mood-home.liquid) DOKUNULMADAN DURUYOR — rollback: templates/index.json'ı
  v1 yedeğine geri döndür (yedek: scratchpad/v1-index-backup.json + clarity-theme/templates/).
  Tüm bölümler Theme Editor'da parça parça düzenlenebilir (section ayarları + bloklar).
  Ürün vitrini gerçek koleksiyondan beslenir; + butonu ürün sayfasına gider
  (listeden sepete-ekle bilinçli yok — Madde 22/28).
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

{%- assign sec = section.settings -%}

<div class="vmh2">

  {%- comment -%} ============ HIZLI KATEGORİ RAYI ============ {%- endcomment -%}
  {%- assign hizli_var = false -%}
  {%- for block in section.blocks -%}{%- if block.type == "hizli" -%}{%- assign hizli_var = true -%}{%- endif -%}{%- endfor -%}
  {%- if hizli_var -%}
  <div class="vmh2-category-rail">
    <div class="vmh2-category-wrap">
      {%- for block in section.blocks -%}
        {%- if block.type == "hizli" -%}
          <a class="vmh2-quick-category" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
            <span class="vmh2-quick-icon">{%- if block.settings.gorsel -%}<img src="{{ block.settings.gorsel | image_url: width: 120 }}" alt="{{ block.settings.baslik | escape }}">{%- else -%}{{ block.settings.ikon | default: "★" }}{%- endif -%}</span>
            <span>{{ block.settings.baslik }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  {%- endif -%}

  {%- comment -%} ============ HERO (slide bloğu varsa karışık sıralı slider) ============ {%- endcomment -%}
  {%- assign slide_sayisi = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == "hero_slide" -%}
      {%- assign slide_sayisi = slide_sayisi | plus: 1 -%}
      {%- if slide_sayisi == 1 -%}{%- assign ilk_slide = block -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%}
    BANNER MODU (14 Ağu 2026): slaytlar hazır kampanya banner'ı ise (kendi başlığı,
    metni, butonu görselin İÇİNDE) hero'nun metin katmanı + koyu gradyan + rozet
    banner'ın üstüne biner ve okunmaz olur. Slaytta başlık/metin YOKSA banner modu:
    yalnız görsel gösterilir ve TÜM alan tıklanabilir olur (cta_link'e gider).
  {%- endcomment -%}
  {%- assign hero_banner_mod = false -%}
  {%- if slide_sayisi > 0 and ilk_slide.settings.baslik == blank and ilk_slide.settings.metin == blank -%}
    {%- assign hero_banner_mod = true -%}
  {%- endif -%}
  <section class="vmh2-hero{% if hero_banner_mod %} vmh2-hero--banner{% endif %}">
    <div class="vmh2-hero-media">
      {%- liquid
        assign hero_img = 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%221600%22 height=%221200%22><rect width=%221600%22 height=%221200%22 fill=%22%23ece5dc%22/></svg>'
        if slide_sayisi > 0
          if ilk_slide.settings.gorsel
            assign hero_img = ilk_slide.settings.gorsel | image_url: width: 2400
          elsif ilk_slide.settings.gorsel_url != blank
            assign hero_img = ilk_slide.settings.gorsel_url
          endif
        endif
      -%}
      <img class="vmh2-hm-a" src="{{ hero_img }}" alt="Via Mood" loading="eager">
      {%- if slide_sayisi > 1 -%}<img class="vmh2-hm-b" src="{{ hero_img }}" alt="" aria-hidden="true">{%- endif -%}
    </div>
    {%- if hero_banner_mod -%}
      <a class="vmh2-hero-link" data-vmh2-hero-link href="{{ ilk_slide.settings.cta_link | default: '/collections/all' }}" aria-label="{{ ilk_slide.settings.eyebrow | default: 'Kampanyayı görüntüle' }}"></a>
    {%- endif -%}
    <div class="vmh2-hero-content">
      {%- if slide_sayisi > 0 -%}
        <span class="vmh2-eyebrow vmh2-hs-fade">{{ ilk_slide.settings.eyebrow }}</span>
        <h1 class="vmh2-hs-fade">{{ ilk_slide.settings.baslik }}</h1>
        <p class="vmh2-hs-fade">{{ ilk_slide.settings.metin }}</p>
      {%- endif -%}
      <div class="vmh2-hero-actions">
        {%- comment -%} Madde 2 Faz-1: slayta özel CTA — doluysa bölüm butonlarının yerine geçer {%- endcomment -%}
        {%- assign slayt_cta_var = false -%}
        {%- if slide_sayisi > 0 and ilk_slide.settings.cta != blank -%}{%- assign slayt_cta_var = true -%}{%- endif -%}
        <a class="vmh2-btn vmh2-btn-primary" data-vmh2-slide-cta href="{{ ilk_slide.settings.cta_link | default: '/collections/all' }}"{% unless slayt_cta_var %} hidden{% endunless %}>{{ ilk_slide.settings.cta }}</a>
        {%- if sec.hero_cta1 != blank -%}<a class="vmh2-btn vmh2-btn-primary" data-vmh2-static-cta href="{{ sec.hero_cta1_link | default: '/collections/all' }}"{% if slayt_cta_var %} hidden{% endif %}>{{ sec.hero_cta1 }}</a>{%- endif -%}
        {%- if sec.hero_cta2 != blank -%}<a class="vmh2-btn vmh2-btn-light" data-vmh2-static-cta href="{{ sec.hero_cta2_link | default: '/collections/all' }}"{% if slayt_cta_var %} hidden{% endif %}>{{ sec.hero_cta2 }}</a>{%- endif -%}
      </div>
    </div>
    {%- if sec.rozet_goster and sec.rozet_buyuk != blank -%}
    <div class="vmh2-hero-badge"><div><strong>{{ sec.rozet_buyuk }}</strong><small>{{ sec.rozet_metin }}</small></div></div>
    {%- endif -%}
    {%- if slide_sayisi > 1 -%}
      {%- comment -%}
        Hero okları (Yunus 11 Eyl 2026). Buton öğesi → klavyeyle erişilebilir.
        Tıklama `git(i, true)`'ya bağlanır; `true` otomatik geçiş sayacını SIFIRLAR,
        yani mevcut 6.5 sn'lik akış bozulmaz, kullanıcı müdahalesinden sonra
        baştan sayar. Banner modunda tüm alanı saran link var — oklar onun
        ÜSTÜNDE (z-index) durmalı, yoksa tıklama koleksiyona gider.
      {%- endcomment -%}
      <button type="button" class="vmh2-hs-ok vmh2-hs-ok--geri" data-vmh2-prev aria-label="Önceki görsel">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M15 5 8 12l7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="vmh2-hs-ok vmh2-hs-ok--ileri" data-vmh2-next aria-label="Sonraki görsel">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="vmh2-hs-dots" role="tablist" aria-label="Slaytlar"></div>
    {%- endif -%}
    {%- comment -%} Theme Editor: her slayt için seçim katmanı — önizlemede tıkla→solda blok seçilir; solda blok seç→slider o slayta atlar {%- endcomment -%}
    {%- if request.design_mode -%}
      {%- assign hs_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == "hero_slide" -%}
          <div class="vmh2-hs-editarea{% if hs_i == 0 %} aktif{% endif %}" data-vmh2-slide-target="{{ hs_i }}" {{ block.shopify_attributes }}></div>
          {%- assign hs_i = hs_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </section>
  {%- if slide_sayisi > 1 -%}
    {%- capture slide_json -%}[
      {%- assign sj = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == "hero_slide" -%}
          {%- if sj > 0 -%},{%- endif -%}
          {%- liquid
            assign s_img = 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%221600%22 height=%221200%22><rect width=%221600%22 height=%221200%22 fill=%22%23ece5dc%22/></svg>'
            if block.settings.gorsel
              assign s_img = block.settings.gorsel | image_url: width: 2400
            elsif block.settings.gorsel_url != blank
              assign s_img = block.settings.gorsel_url
            endif
          -%}
          {"g":{{ s_img | json }},"e":{{ block.settings.eyebrow | json }},"b":{{ block.settings.baslik | json }},"m":{{ block.settings.metin | json }},"c":{{ block.settings.cta | json }},"l":{{ block.settings.cta_link | json }}}
          {%- assign sj = sj | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ]{%- endcapture -%}
    <script type="application/json" data-vmh2-slides>{{ slide_json }}</script>
    <script>
      (function(){
        var el=document.querySelector('[data-vmh2-slides]'); if(!el) return;
        var slides; try{ slides=JSON.parse(el.textContent); }catch(err){ return; }
        if(!slides || slides.length < 2) return;
        var DESIGN = !!(window.Shopify && Shopify.designMode);
        slides.forEach(function(s,i){ s._o = i; });
        var KARISIK = {{ sec.hero_karisik | json }};
        if(KARISIK !== false && !DESIGN){
          // Fisher-Yates — her yüklemede farklı akış sırası
          for(var i=slides.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=slides[i]; slides[i]=slides[j]; slides[j]=t; }
        }
        var hero=document.querySelector('.vmh2-hero'); if(!hero) return;
        var imgA=hero.querySelector('.vmh2-hm-a'), imgB=hero.querySelector('.vmh2-hm-b');
        var eEl=hero.querySelector('.vmh2-eyebrow'), hEl=hero.querySelector('.vmh2-hero-content h1'), pEl=hero.querySelector('.vmh2-hero-content p');
        var dots=hero.querySelector('.vmh2-hs-dots');
        var ctaEl=hero.querySelector('[data-vmh2-slide-cta]');
        var linkEl=hero.querySelector('[data-vmh2-hero-link]'); // banner modu: tüm alanı saran link
        var statikler=[].slice.call(hero.querySelectorAll('[data-vmh2-static-cta]'));
        var idx=0, onA=true, timer=null;
        if(dots){ slides.forEach(function(_,i){ var d=document.createElement('button'); d.type='button'; d.setAttribute('aria-label','Slayt '+(i+1)); d.addEventListener('click',function(){ git(i,true); }); dots.appendChild(d); }); }
        function boyaDots(){ if(!dots) return; [].forEach.call(dots.children,function(d,i){ d.className = i===idx ? 'aktif' : ''; }); }
        var alanlar=[].slice.call(hero.querySelectorAll('[data-vmh2-slide-target]'));
        function alanAktifle(){ alanlar.forEach(function(a){ a.classList.toggle('aktif', parseInt(a.getAttribute('data-vmh2-slide-target'),10)===slides[idx]._o); }); }
        function metinYaz(v){
          if(linkEl){ linkEl.setAttribute('href', v.l||'/collections/all'); if(v.e) linkEl.setAttribute('aria-label', v.e); }
          if(eEl){ eEl.textContent=v.e||''; eEl.style.display=v.e?'':'none'; }
          if(hEl) hEl.innerHTML=v.b||'';
          if(pEl){ pEl.textContent=v.m||''; pEl.style.display=v.m?'':'none'; }
          if(ctaEl){
            if(v.c){ ctaEl.textContent=v.c; ctaEl.setAttribute('href', v.l||'/collections/all'); ctaEl.hidden=false; }
            else { ctaEl.hidden=true; }
            statikler.forEach(function(s){ s.hidden=!!v.c; });
          }
        }
        function git(i, elle){
          idx=(i+slides.length)%slides.length; var v=slides[idx];
          var giren=onA?imgB:imgA, cikan=onA?imgA:imgB;
          if(giren && v.g){ var pre=new Image(); pre.onload=function(){ giren.src=v.g; giren.classList.add('vmh2-hm-gorunur'); cikan.classList.remove('vmh2-hm-gorunur'); }; pre.src=v.g; onA=!onA; }
          [eEl,hEl,pEl].forEach(function(x){ if(x) x.classList.add('vmh2-solgun'); });
          setTimeout(function(){ metinYaz(v); [eEl,hEl,pEl].forEach(function(x){ if(x) x.classList.remove('vmh2-solgun'); }); }, 360);
          boyaDots();
          alanAktifle();
          if(elle) kur();
        }
        // Hero okları — `git(i,true)` çağrılır; true, autoplay sayacını sıfırlar.
        var okGeri=hero.querySelector('[data-vmh2-prev]'), okIleri=hero.querySelector('[data-vmh2-next]');
        if(okGeri) okGeri.addEventListener('click',function(e){ e.preventDefault(); e.stopPropagation(); git(idx-1,true); });
        if(okIleri) okIleri.addEventListener('click',function(e){ e.preventDefault(); e.stopPropagation(); git(idx+1,true); });
        function kur(){ clearInterval(timer); if(DESIGN) return; if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){ timer=setInterval(function(){ git(idx+1,false); },6500); } }
        // ilk gösterim: karışık sıranın başı (server ilk bloğu bastı — anında değiştir)
        if(imgA) imgA.classList.add('vmh2-hm-gorunur');
        metinYaz(slides[0]); if(imgA && slides[0].g && imgA.src!==slides[0].g) imgA.src=slides[0].g;
        boyaDots(); alanAktifle(); kur();
        if(DESIGN){
          document.addEventListener('shopify:block:select', function(e){
            var t = e.target; if(!t || !t.getAttribute) return;
            var v = t.getAttribute('data-vmh2-slide-target'); if(v === null) return;
            var o = parseInt(v, 10);
            for(var j = 0; j < slides.length; j++){ if(slides[j]._o === o){ if(j !== idx) git(j, true); break; } }
          });
        }
        window.addEventListener('pageshow',function(ev){ if(ev && ev.persisted){ git(KARISIK!==false?Math.floor(Math.random()*slides.length):0,false); kur(); } });
      })();
    </script>
  {%- endif -%}

  {%- comment -%} ============ AVANTAJ ŞERİDİ ============ {%- endcomment -%}
  {%- assign avantaj_var = false -%}
  {%- for block in section.blocks -%}{%- if block.type == "avantaj" -%}{%- assign avantaj_var = true -%}{%- endif -%}{%- endfor -%}
  {%- if avantaj_var -%}
  <div class="vmh2-benefit-strip vmh2-reveal">
    {%- for block in section.blocks -%}
      {%- if block.type == "avantaj" -%}
        <div class="vmh2-benefit" {{ block.shopify_attributes }}>
          <span class="vmh2-benefit-icon">{{ block.settings.ikon | default: "✓" }}</span>
          <div><strong>{{ block.settings.baslik }}</strong><span>{{ block.settings.alt_metin }}</span></div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- endif -%}


  {%- comment -%} ============ ÜRÜN VİTRİNİ ============ {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == "urunler" -%}
      {%- assign col = collections[block.settings.koleksiyon] -%}
      {%- if col == blank or col.products_count == 0 -%}{%- assign col = collections.all -%}{%- endif -%}
      <section class="vmh2-section vmh2-reveal" id="vmh2-best" {{ block.shopify_attributes }}>
        <div class="vmh2-section-head">
          <div>
            {%- if block.settings.kicker != blank -%}<div class="vmh2-section-kicker">{{ block.settings.kicker }}</div>{%- endif -%}
            <h2>{{ block.settings.baslik }}</h2>
          </div>
          <a href="{{ col.url }}" class="vmh2-btn vmh2-btn-ghost">{{ block.settings.tumu_metin | default: "Tümünü Gör →" }}</a>
        </div>
        {%- comment -%} rastgele=true: 24'lük havuz bas, JS her ziyarette karıştırıp adet kadarını gösterir {%- endcomment -%}
        {%- assign urun_limit = block.settings.adet -%}
        {%- if block.settings.rastgele and block.settings.slider != true -%}{%- assign urun_limit = 24 -%}{%- endif -%}
        {%- if block.settings.slider -%}{%- assign urun_limit = 30 -%}{%- endif -%}
        <div class="vmh2-products{% if block.settings.slider %} vmh2-products--slider{% endif %}"{% if block.settings.rastgele and block.settings.slider != true %} data-vmh2-random="{{ block.settings.adet }}"{% endif %}>
          {%- for p in col.products limit: urun_limit -%}
            <article class="vmh2-product-card"{% if block.settings.rastgele and block.settings.slider != true %} data-vmh2-pool{% if forloop.index > block.settings.adet %} hidden{% endif %}{% endif %}>
              <a href="{{ p.url }}" class="vmh2-product-image">
                {%- if p.featured_image -%}
                  <img src="{{ p.featured_image | image_url: width: 900 }}" alt="{{ p.title | escape }}" loading="lazy">
                {%- endif -%}
                {%- if p.compare_at_price > p.price -%}
                  {%- assign indirim = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
                  <span class="vmh2-pill">%{{ indirim }} İNDİRİM</span>
                {%- elsif forloop.first and block.settings.slider != true -%}
                  <span class="vmh2-pill">ÇOK SATAN</span>
                {%- endif -%}
              </a>
              <div class="vmh2-product-info">
                <small>{{ p.vendor | default: "Via Mood" }}</small>
                <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
                <div class="vmh2-price-row">
                  <div>
                    <span class="vmh2-price">{{ p.price | money }}</span>
                    {%- if p.compare_at_price > p.price -%}<span class="vmh2-old-price">{{ p.compare_at_price | money }}</span>{%- endif -%}
                  </div>
                  <a class="vmh2-mini-add" href="{{ p.url }}" aria-label="{{ p.title | escape }} — ürüne git">+</a>
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ============ HİKÂYE ============ {%- endcomment -%}
  {%- for block in section.blocks -%}
    {%- if block.type == "hikaye" -%}
      <section class="vmh2-section vmh2-reveal" id="vmh2-story" {{ block.shopify_attributes }}>
        <div class="vmh2-story">
          <div class="vmh2-story-copy">
            {%- if block.settings.kicker != blank -%}<div class="vmh2-section-kicker vmh2-kicker-acik">{{ block.settings.kicker }}</div>{%- endif -%}
            <h2>{{ block.settings.baslik }}</h2>
            <p>{{ block.settings.metin }}</p>
            {%- if block.settings.cta != blank -%}
              <a href="{{ block.settings.link | default: '/pages/hakkimizda' }}" class="vmh2-btn vmh2-btn-light vmh2-story-cta">{{ block.settings.cta }}</a>
            {%- endif -%}
          </div>
          <div class="vmh2-story-media">
            {%- if block.settings.gorsel -%}
              <img src="{{ block.settings.gorsel | image_url: width: 1400 }}" alt="{{ block.settings.baslik | escape }}" loading="lazy">
            {%- else -%}
              <img src="data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%221600%22 height=%221200%22><rect width=%221600%22 height=%221200%22 fill=%22%23ece5dc%22/></svg>" alt="" loading="lazy">
            {%- endif -%}
            {%- if block.settings.etiket != blank -%}<div class="vmh2-story-tag">{{ block.settings.etiket }}</div>{%- endif -%}
          </div>
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ============ İLHAM GALERİSİ ============ {%- endcomment -%}
  {%- assign ilham_var = false -%}
  {%- for block in section.blocks -%}{%- if block.type == "ilham" -%}{%- assign ilham_var = true -%}{%- endif -%}{%- endfor -%}
  {%- if ilham_var -%}
  <section class="vmh2-section vmh2-reveal" id="vmh2-inspiration">
    <div class="vmh2-section-head">
      <div>
        {%- if sec.ilham_kicker != blank -%}<div class="vmh2-section-kicker">{{ sec.ilham_kicker }}</div>{%- endif -%}
        <h2>{{ sec.ilham_baslik }}</h2>
      </div>
      {%- if sec.ilham_not != blank -%}<p class="vmh2-section-note">{{ sec.ilham_not }}</p>{%- endif -%}
    </div>
    <div class="vmh2-inspiration-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == "ilham" -%}
          <div class="vmh2-inspiration-card" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
            {%- if block.settings.gorsel -%}
              <img src="{{ block.settings.gorsel | image_url: width: 1200 }}" alt="{{ block.settings.gorsel.alt | default: 'Via Mood ilham' | escape }}" loading="lazy">
            {%- else -%}
              <img src="{{ block.settings.gorsel_url | default: 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%221600%22 height=%221200%22><rect width=%221600%22 height=%221200%22 fill=%22%23ece5dc%22/></svg>' }}" alt="Via Mood ilham" loading="lazy">
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ============ KATEGORİ VİTRİNLERİ (sağ/sol dönüşümlü bantlar) ============ {%- endcomment -%}
  {%- assign vitrin_i = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == "vitrin" -%}
      {%- liquid
        assign vitrin_i = vitrin_i | plus: 1
        assign col = block.settings.koleksiyon
        assign v_baslik = block.settings.baslik
        if v_baslik == blank and col
          assign v_baslik = col.title
        endif
        assign v_link = '/collections/all'
        if col
          assign v_link = col.url
        endif
        assign v_img = ''
        if block.settings.gorsel
          assign v_img = block.settings.gorsel | image_url: width: 1400
        elsif block.settings.gorsel_url != blank
          assign v_img = block.settings.gorsel_url
        elsif col.image
          assign v_img = col.image | image_url: width: 1400
        elsif col.products.first.featured_image
          assign v_img = col.products.first.featured_image | image_url: width: 1400
        endif
        assign urun_n = block.settings.urun_adedi | default: 3
        assign yon = vitrin_i | modulo: 2
      -%}
      <section class="vmh2-vitrin vmh2-reveal{% if yon == 0 %} vmh2-vitrin-ters{% endif %}" {{ block.shopify_attributes }}>
        <a class="vmh2-vitrin-media" href="{{ v_link }}" aria-label="{{ v_baslik | escape }}">
          {%- if v_img != blank -%}<img src="{{ v_img }}" alt="{{ v_baslik | escape }}" loading="lazy">{%- endif -%}
          <span class="vmh2-vitrin-tag">{{ v_baslik }}</span>
        </a>
        <div class="vmh2-vitrin-copy">
          {%- if block.settings.kicker != blank -%}<div class="vmh2-section-kicker">{{ block.settings.kicker }}</div>{%- endif -%}
          <h3>{{ v_baslik }}</h3>
          {%- if block.settings.metin != blank -%}<p>{{ block.settings.metin }}</p>{%- endif -%}
          {%- if col and urun_n > 0 -%}
          <div class="vmh2-vitrin-urunler">
            {%- for p in col.products limit: urun_n -%}
              <a class="vmh2-vitrin-urun" href="{{ p.url }}">
                <span class="vu-img">{%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy">{%- endif -%}</span>
                <span class="vu-ad">{{ p.title | truncate: 44 }}</span>
                <span class="vu-fiyat">{{ p.price | money }}</span>
              </a>
            {%- endfor -%}
          </div>
          {%- endif -%}
          <a class="vmh2-btn vmh2-btn-primary vmh2-vitrin-cta" href="{{ v_link }}">{{ block.settings.cta | default: 'Tümünü keşfet →' }}</a>
        </div>
      </section>
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%} ============ MÜŞTERİ YORUMLARI (API-driven — hesap.viamood.com.tr, Club öncesi boş alan) ============ {%- endcomment -%}
  <section class="vmh2-section vmy" id="vmh2-yorumlar" data-vmy-api="https://hesap.viamood.com.tr/api/v1/storefront/reviews" hidden>
    <div class="vmy-head">
      <div class="vmh2-section-kicker">Müşteri Yorumları</div>
      <h2>Müşterilerimiz bizi seviyor</h2>
      <div class="vmy-trust" data-vmy-trust hidden>
        <span class="vmy-trust-score" data-vmy-avg>5,0</span>
        <span class="vmy-stars vmy-stars-lg" aria-hidden="true">★★★★★</span>
        <span class="vmy-trust-count" data-vmy-count></span>
      </div>
    </div>
    <div class="vmy-carousel"><div class="vmy-track" data-vmy-track></div></div>
    <div class="vmy-cta" style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;align-items:center"><a href="/pages/yorumlar" class="vmh2-btn vmh2-btn-primary">Tüm müşteri yorumlarını gör →</a><button type="button" class="vmh2-btn vmh2-btn-light" data-vmy-open>Sen de yorum yaz →</button></div>

    <div class="vmy-modal" data-vmy-modal hidden>
      <div class="vmy-modal-card" role="dialog" aria-modal="true" aria-label="Yorum yaz">
        <button class="vmy-modal-close" type="button" data-vmy-close aria-label="Kapat">×</button>
        <h3>Deneyimini paylaş</h3>
        <p class="vmy-modal-sub">Via Mood'dan alışveriş yaptıysan yorumunu bırak. Yorumun <strong>admin onayından</strong> sonra yayınlanır.</p>
        <form data-vmy-form novalidate>
          <div class="vmy-fstars" data-vmy-fstars role="radiogroup" aria-label="Puan">
            <span data-v="1">★</span><span data-v="2">★</span><span data-v="3">★</span><span data-v="4">★</span><span data-v="5">★</span>
          </div>
          <input type="hidden" name="puan" value="5">
          <input name="isim" placeholder="Ad Soyad" required maxlength="80" autocomplete="name">
          <input name="urun" placeholder="Aldığın ürün (opsiyonel)" maxlength="160">
          <textarea name="metin" placeholder="Ürünle ilgili deneyimini yaz..." required rows="4" maxlength="1000"></textarea>
          <input type="text" name="website" class="vmy-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button type="submit" class="vmh2-btn vmh2-btn-primary" data-vmy-submit>Yorumu gönder</button>
          <p class="vmy-form-msg" data-vmy-msg role="status"></p>
        </form>
      </div>
    </div>
  </section>

  <style>
    #vmh2-yorumlar.vmy{--star:#f0a636}
    #vmh2-yorumlar .vmy-head{text-align:center;max-width:720px;margin:0 auto 40px}
    #vmh2-yorumlar .vmy-head h2{margin-top:6px}
    #vmh2-yorumlar .vmy-trust{display:inline-flex;align-items:center;gap:12px;margin-top:20px;padding:11px 20px;background:var(--vmh2-paper);border:1px solid var(--vmh2-line);border-radius:999px;box-shadow:0 10px 28px rgba(49,38,28,.07)}
    #vmh2-yorumlar .vmy-trust-score{font-weight:800;font-size:20px}
    #vmh2-yorumlar .vmy-trust-count{color:var(--vmh2-muted);font-size:13px;border-left:1px solid var(--vmh2-line);padding-left:12px}
    #vmh2-yorumlar .vmy-stars{letter-spacing:2px;line-height:1;color:var(--star)}
    #vmh2-yorumlar .vmy-stars-lg{font-size:17px}
    #vmh2-yorumlar .vmy-stars .off{color:#dcd3c6}
    #vmh2-yorumlar .vmy-track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(320px,1fr);gap:22px;overflow-x:auto;scroll-snap-type:x mandatory;padding:6px 2px 20px;scrollbar-width:none}
    #vmh2-yorumlar .vmy-track::-webkit-scrollbar{display:none}
    #vmh2-yorumlar .vmy-card{scroll-snap-align:start;background:var(--vmh2-paper);border:1px solid var(--vmh2-line);border-radius:22px;padding:26px 24px;display:flex;flex-direction:column;gap:14px;box-shadow:0 14px 34px rgba(45,33,24,.05)}
    #vmh2-yorumlar .vmy-card .vmy-stars{font-size:15px}
    #vmh2-yorumlar .vmy-text{margin:0;line-height:1.72;color:#3c3934;font-size:15px;flex:1}
    #vmh2-yorumlar .vmy-media{margin:0;border-radius:14px;overflow:hidden;border:1px solid var(--vmh2-line);aspect-ratio:16/10;background:#efe6da}
    #vmh2-yorumlar .vmy-media img{width:100%;height:100%;object-fit:cover;display:block}
    #vmh2-yorumlar .vmy-foot{display:flex;align-items:center;gap:12px;margin-top:2px}
    #vmh2-yorumlar .vmy-avatar{width:44px;height:44px;border-radius:50%;flex:none;display:grid;place-items:center;background:#efe0d0;color:var(--vmh2-orange);font-weight:800;font-size:16px}
    #vmh2-yorumlar .vmy-who{display:flex;flex-direction:column;min-width:0}
    #vmh2-yorumlar .vmy-who strong{font-size:14px;font-weight:700}
    #vmh2-yorumlar .vmy-who small{font-size:12px;color:var(--vmh2-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    #vmh2-yorumlar .vmy-verified{margin-left:auto;flex:none;display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:var(--vmh2-orange)}
    #vmh2-yorumlar .vmy-cta{text-align:center;margin-top:28px}
    @media(min-width:1080px){ #vmh2-yorumlar .vmy-track{grid-auto-flow:row;grid-template-columns:repeat(3,1fr);overflow:visible} }
    @media(max-width:640px){ #vmh2-yorumlar .vmy-track{grid-auto-columns:minmax(82vw,82vw)} }
    /* modal */
    #vmh2-yorumlar .vmy-modal{position:fixed;inset:0;z-index:9999;background:rgba(34,33,31,.55);display:flex;align-items:center;justify-content:center;padding:20px}
    #vmh2-yorumlar .vmy-modal[hidden]{display:none!important}
    #vmh2-yorumlar .vmy-modal-card{position:relative;background:var(--vmh2-paper);border-radius:24px;padding:32px;width:min(520px,100%);max-height:90vh;overflow:auto;box-shadow:0 30px 80px rgba(0,0,0,.3)}
    #vmh2-yorumlar .vmy-modal-close{position:absolute;top:14px;right:16px;background:none;border:none;font-size:28px;line-height:1;color:#999;cursor:pointer}
    #vmh2-yorumlar .vmy-modal-card h3{font-family:"Playfair Display",serif;font-size:26px;margin:0 0 6px}
    #vmh2-yorumlar .vmy-modal-sub{color:var(--vmh2-muted);font-size:14px;margin:0 0 18px}
    #vmh2-yorumlar .vmy-modal-card form{display:flex;flex-direction:column;gap:12px}
    #vmh2-yorumlar .vmy-modal-card input,#vmh2-yorumlar .vmy-modal-card textarea{width:100%;border:1px solid #ddd2c2;border-radius:12px;padding:12px 14px;font-family:inherit;font-size:14px;background:#fff}
    #vmh2-yorumlar .vmy-fstars{display:flex;gap:6px;font-size:30px;color:#dcd3c6;cursor:pointer;user-select:none}
    #vmh2-yorumlar .vmy-fstars span{transition:color .1s}
    #vmh2-yorumlar .vmy-fstars span.on{color:var(--star)}
    #vmh2-yorumlar .vmy-hp{position:absolute!important;left:-9999px!important;width:1px;height:1px}
    #vmh2-yorumlar .vmy-form-msg{font-size:13px;margin:2px 0 0;min-height:18px}
    #vmh2-yorumlar .vmy-form-msg.ok{color:#3f7a3a}
    #vmh2-yorumlar .vmy-form-msg.err{color:#c0392b}
  </style>

  <script>
    (function(){
      var sec=document.getElementById('vmh2-yorumlar'); if(!sec) return;
      var api=sec.getAttribute('data-vmy-api');
      var track=sec.querySelector('[data-vmy-track]');
      function esc(s){var d=document.createElement('div');d.textContent=s==null?'':String(s);return d.innerHTML;}
      function stars(n){n=Math.max(0,Math.min(5,n|0));var h='';for(var i=1;i<=5;i++){h+='<span'+(i<=n?'':' class="off"')+'>★</span>';}return h;}
      function card(r){
        var initial=(r.authorName||'V').trim().charAt(0).toUpperCase();
        var sub=[r.location,r.productTitle].filter(Boolean).map(esc).join(' · ');
        var media=r.imageUrl?'<div class="vmy-media"><img src="'+esc(r.imageUrl)+'" alt="'+esc(r.productTitle||r.authorName)+'" loading="lazy"></div>':'';
        var badge=r.verifiedBuyer?'<span class="vmy-verified" title="Doğrulanmış alışveriş"><svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M12 1 3 5v6c0 5 3.8 9.7 9 11 5.2-1.3 9-6 9-11V5l-9-4Zm-1.2 14.2-3.5-3.5 1.4-1.4 2.1 2.1 4.9-4.9 1.4 1.4-6.3 6.3Z"/></svg>Doğrulanmış</span>':'';
        return '<article class="vmy-card"><div class="vmy-stars" role="img" aria-label="'+ (r.rating||5) +' / 5">'+stars(r.rating)+'</div>'+
          '<p class="vmy-text">'+esc(r.body)+'</p>'+media+
          '<div class="vmy-foot"><span class="vmy-avatar" aria-hidden="true">'+esc(initial)+'</span>'+
          '<div class="vmy-who"><strong>'+esc(r.authorName||'Via Mood Müşterisi')+'</strong><small>'+sub+'</small></div>'+badge+'</div></article>';
      }
      function shuffle(a){for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t;}return a;}
      fetch(api,{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(d){
        if(!d||!d.ok||!d.reviews||!d.reviews.length) return; // yorum yoksa bölüm gizli kalır (boş bant olmaz)
        var list=shuffle(d.reviews.slice()).slice(0,9);
        track.innerHTML=list.map(card).join('');
        var trust=sec.querySelector('[data-vmy-trust]');
        if(d.average){ sec.querySelector('[data-vmy-avg]').textContent=String(d.average).replace('.',','); }
        if(d.count){ sec.querySelector('[data-vmy-count]').textContent=d.count+' değerlendirme'; }
        if(trust) trust.hidden=false;
        sec.hidden=false;
      }).catch(function(){/* sessiz — bölüm gizli kalır */});

      // ---- Yorum yaz modal + form ----
      var modal=sec.querySelector('[data-vmy-modal]');
      function openModal(){modal.hidden=false;document.body.style.overflow='hidden';}
      function closeModal(){modal.hidden=true;document.body.style.overflow='';}
      sec.querySelector('[data-vmy-open]').addEventListener('click',openModal);
      sec.querySelector('[data-vmy-close]').addEventListener('click',closeModal);
      modal.addEventListener('click',function(e){if(e.target===modal)closeModal();});
      document.addEventListener('keydown',function(e){if((e.key==='Escape'||e.key==='Esc')&&!modal.hidden)closeModal();});
      // yıldız seçimi
      var fstars=sec.querySelector('[data-vmy-fstars]');
      var puanInput=sec.querySelector('input[name="puan"]');
      function paint(n){[].forEach.call(fstars.children,function(s,i){s.className=(i<n)?'on':'';});}
      paint(5);
      [].forEach.call(fstars.children,function(s,i){s.addEventListener('click',function(){puanInput.value=i+1;paint(i+1);});});
      // gönder
      var form=sec.querySelector('[data-vmy-form]');
      var msg=sec.querySelector('[data-vmy-msg]');
      form.addEventListener('submit',function(e){
        e.preventDefault();
        var btn=sec.querySelector('[data-vmy-submit]');
        var body={isim:form.isim.value.trim(),metin:form.metin.value.trim(),puan:Number(puanInput.value)||5,urun:form.urun.value.trim(),website:form.website.value};
        msg.className='vmy-form-msg';msg.textContent='';
        if(body.isim.length<2||body.metin.length<10){msg.className='vmy-form-msg err';msg.textContent='İsim ve en az 10 karakterlik yorum gerekli.';return;}
        btn.disabled=true;btn.textContent='Gönderiliyor...';
        fetch(api,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(function(r){return r.json();}).then(function(d){
          if(d&&d.ok){msg.className='vmy-form-msg ok';msg.textContent=d.message||'Yorumun alındı, onaydan sonra yayınlanacak. Teşekkürler!';form.reset();paint(5);puanInput.value=5;setTimeout(closeModal,2200);}
          else{msg.className='vmy-form-msg err';msg.textContent=(d&&d.error)||'Gönderilemedi, tekrar deneyin.';}
        }).catch(function(){msg.className='vmy-form-msg err';msg.textContent='Bağlantı hatası, tekrar deneyin.';})
        .then(function(){btn.disabled=false;btn.textContent='Yorumu gönder';});
      });
    })();
  </script>

  {%- comment -%} ============ KATEGORİ KARTLARI ============ {%- endcomment -%}
  {%- assign kategori_var = false -%}
  {%- for block in section.blocks -%}{%- if block.type == "kategori" -%}{%- assign kategori_var = true -%}{%- endif -%}{%- endfor -%}
  {%- if kategori_var -%}
  <section class="vmh2-section vmh2-reveal" id="vmh2-categories">
    <div class="vmh2-section-head">
      <div>
        {%- if sec.kat_kicker != blank -%}<div class="vmh2-section-kicker">{{ sec.kat_kicker }}</div>{%- endif -%}
        <h2>{{ sec.kat_baslik }}</h2>
      </div>
      {%- if sec.kat_not != blank -%}<p class="vmh2-section-note">{{ sec.kat_not }}</p>{%- endif -%}
    </div>
    <div class="vmh2-category-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == "kategori" -%}
          <a class="vmh2-category-card" href="{{ block.settings.link | default: '/collections/all' }}" {{ block.shopify_attributes }}>
            {%- if block.settings.gorsel -%}
              <img src="{{ block.settings.gorsel | image_url: width: 1200 }}" alt="{{ block.settings.baslik | escape }}" loading="lazy">
            {%- else -%}
              <img src="{{ block.settings.gorsel_url | default: 'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%221600%22 height=%221200%22><rect width=%221600%22 height=%221200%22 fill=%22%23ece5dc%22/></svg>' }}" alt="{{ block.settings.baslik | escape }}" loading="lazy">
            {%- endif -%}
            <div class="vmh2-category-copy">
              {%- if block.settings.alt_metin != blank -%}<small>{{ block.settings.alt_metin }}</small>{%- endif -%}
